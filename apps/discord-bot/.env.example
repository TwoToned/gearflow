# GearFlow Discord bot — only two secrets live here. Everything else (Discord
# bot token, application id, guild id, category ids, signing secret, status
# rules, behavior toggles) is configured at GearFlow → Settings → Discord.

# Global Bearer that authenticates this bot process against /api/discord/v1/*
# (must match the app's DISCORD_BOT_TOKEN env on the GearFlow deployment).
GEARFLOW_BOT_BEARER=

# Which GearFlow organisation this bot process serves (single-org per process).
# Find the cuid in the URL after picking an org, or query `select id from "organization";`.
GEARFLOW_ORG_ID=

# Optional overrides:
# GEARFLOW_API_URL=https://home.twotoned.com.au   # defaults to twotoned production
# POLL_INTERVAL_MS=5000                            # min 500, default 5000
