// ─── Project Line Item ───────────────────────────────────────────────────────

model ProjectLineItem {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                LineItemType          @default(EQUIPMENT)
  modelId             String?
  model               Model?                @relation(fields: [modelId], references: [id])
  assetId             String?
  asset               Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  bulkAssetId         String?
  bulkAsset           BulkAsset?            @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)
  kitId               String?
  kit                 Kit?                  @relation(fields: [kitId], references: [id], onDelete: SetNull)
  // `isKitChild` is the structural "is a non-top-level child" flag — it is set
  // on kit children, sub-hire group children, AND (since the accessories
  // feature) accessory children. The ~40 `isKitChild: false` filters across the
  // app rely on it to exclude every kind of child from top-level totals/counts.
  // `childKind` is the discriminator that distinguishes WHAT kind of child a row
  // is, for behaviour that differs (render label, remove-error copy, scan routing).
  isKitChild          Boolean               @default(false)
  childKind           LineItemChildKind?
  parentLineItemId    String?
  parentLineItem      ProjectLineItem?      @relation("KitLineItemChildren", fields: [parentLineItemId], references: [id], onDelete: Cascade)
  childLineItems      ProjectLineItem[]     @relation("KitLineItemChildren")
  pricingMode         KitPricingMode?
  description         String?
  quantity            Int                   @default(1)
  unitPrice           Decimal?              @db.Decimal(10, 2)
  pricingType         PricingType           @default(PER_DAY)
  duration            Int                   @default(1)
  discount            Decimal?              @db.Decimal(10, 2)
  lineTotal           Decimal?              @db.Decimal(12, 2)
  priceBreakdown      String?
  priceOverridden     Boolean               @default(false)
  overrideReason      String?
  sortOrder           Int                   @default(0)
  groupName           String?
  categoryId          String?
  category            ProjectCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  groupId             String?
  group               ProjectGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notes               String?
  isOptional          Boolean               @default(false)
  status              LineItemStatus        @default(QUOTED)
  checkedOutQuantity  Int                   @default(0)
  returnedQuantity    Int                   @default(0)
  // Rollup counters derived from ProjectLineItemUnit rows. Kept in sync
  // transactionally on every unit write once Phase 3 lands.
  assignedQuantity    Int                   @default(0)
  packedQuantity      Int                   @default(0)
  damagedQuantity     Int                   @default(0)
  lostQuantity        Int                   @default(0)
  checkedOutAt        DateTime?
  checkedOutById      String?
  checkedOutBy        User?                 @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  returnedAt          DateTime?
  returnedById        String?
  returnedBy          User?                 @relation("ReturnedBy", fields: [returnedById], references: [id])
  returnCondition     ReturnCondition?
  returnNotes         String?
  prepStatus          PrepStatus?
  prepContainer       String?
  isContainerLineItem Boolean               @default(false)
  isCustomItem        Boolean               @default(false)
  returnStatus        ReturnStatus?
  // `isSubhire` removed (Wave 2). Sub-hire detection is now
  // `subHireId != null` — single source of truth. Production
  // verified to have 0 legacy-only rows before drop. See
  // 20260514XXXXXX_drop_line_item_isSubhire migration.
  showSubhireOnDocs   Boolean               @default(false)
  supplierId          String?
  supplier            Supplier?             @relation(fields: [supplierId], references: [id])
  subhireOrderNumber  String?
  supplierOrderId     String?
  supplierOrder       SupplierOrder?        @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  subHireId           String?
  subHire             SubHire?              @relation(fields: [subHireId], references: [id], onDelete: SetNull)
  subHireItemId       String?
  subHireItem         SubHireItem?          @relation(fields: [subHireItemId], references: [id], onDelete: SetNull)
  subHireGroupId      String?
  subHireGroup        SubHireGroup?         @relation(fields: [subHireGroupId], references: [id], onDelete: SetNull)
  service             ProjectService?
  checkRecords        CheckRecord[]
  units               ProjectLineItemUnit[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([modelId])
  @@index([assetId])
  @@index([bulkAssetId])
  @@index([kitId])
  @@index([parentLineItemId])
  @@index([supplierId])
  @@index([supplierOrderId])
  @@index([subHireId])
  @@index([subHireItemId])
  @@index([subHireGroupId])
  @@index([categoryId])
  @@index([groupId])
  @@map("project_line_item")
}

// ─── Project Line-Item Unit ─────────────────────────────────────────────────
// One physical unit assigned to an order line. Replaces the old "split a
// qty-N line into N qty-1 rows" mechanism: serialised assets get one row each
// (quantity 1), bulk assets get one row carrying a quantity. Per-unit deploy /
// return state lives here, not on the order line.
// See docs/designs/line-item-fulfillment-model.md.

model ProjectLineItemUnit {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItemId       String
  lineItem         ProjectLineItem  @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  ordinal          Int
  assetId          String?
  asset            Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  bulkAssetId      String?
  bulkAsset        BulkAsset?       @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)
  // For an ACCESSORY-line unit: the parent unit's asset this accessory travels
  // with (the specific handheld a battery kit is packed under). Null on normal
  // (non-accessory) units. Denormalised link to the parent asset id, mirroring
  // how serialised accessory children use Asset.parentAssetId — lets prep/return
  // and the per-unit docket render scope an accessory to one parent unit.
  parentUnitAssetId String?
  quantity         Int              @default(1)
  returnedQuantity Int              @default(0)
  status           LineItemStatus   @default(CONFIRMED)
  prepStatus       PrepStatus?
  prepContainer    String?
  checkedOutAt     DateTime?
  checkedOutById   String?
  returnedAt       DateTime?
  returnedById     String?
  returnCondition  ReturnCondition?
  returnStatus     ReturnStatus?
  returnNotes      String?
  checkRecords     CheckRecord[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([lineItemId, assetId])
  @@unique([lineItemId, ordinal])
  @@index([organizationId, assetId, status])
  @@index([organizationId, bulkAssetId, status])
  @@index([lineItemId, status])
  @@index([lineItemId, parentUnitAssetId])
  @@map("project_line_item_unit")
}

/// Audit trail for the Phase 3.8 split-sibling collapse migration.
///
/// When the historic data has lines that splitLineItem fragmented into
/// per-asset siblings, the collapse migration merges them back onto one
/// canonical order line — moving each sibling's ProjectLineItemUnit, its
/// CheckRecord rows, and its ProjectService onto the
/// canonical, then deactivating the old row. This table records the
/// mapping so the merge can be audited and (if needed) reversed.
///
/// Permanent — never auto-cleaned. One row per merged (old) line item.
model LineItemMergeMap {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The line item that was merged away. Kept in the projectLineItem
  /// table (status: CANCELLED, quantity: 0, assetId: null) so historical
  /// data isn't destroyed — only made inert.
  oldLineItemId         String       @unique
  /// The line item the units / records were re-pointed to.
  canonicalLineItemId   String
  /// The unit row that carried the old line's asset/bulk allocation
  /// after the move. Null when the old row had no unit (rare —
  /// pre-Phase-2a rows or kit children).
  movedUnitId           String?
  checkRecordsRepointed Int          @default(0)
  serviceRepointed      Boolean      @default(false)
  /// Free-form notes captured at merge time (eg. the equivalence-key
  /// snapshot, dry-run vs. apply, the run id).
  notes                 String?
  mergedAt              DateTime     @default(now())

  @@index([organizationId])
  @@index([canonicalLineItemId])
  @@map("line_item_merge_map")
}

// ─── Project Category ───────────────────────────────────────────────────────

model ProjectCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  groups              ProjectGroup[]
  lineItems           ProjectLineItem[]
  // Sub-hire placement targets
  subHireDefaults     SubHire[]
  subHireGroupTargets SubHireGroup[]
  subHireItemTargets  SubHireItem[]
  // Cross-type ordering: project + sub-hire groups share one sort sequence per category
  slots               CategorySlot[]

  @@index([projectId])
  @@index([organizationId])
  @@map("project_category")
}

// ─── Category Slot ──────────────────────────────────────────────────────────
//
// Cross-type ordering for ProjectGroup + SubHireGroup within a ProjectCategory.
// Each slot points at exactly one group (XOR enforced by DB check constraint
// added in the migration SQL — Prisma doesn't support CHECK in schema.prisma).
// The slot's sortOrder is the canonical ordering for queries that need a
// unified group list per category.

model CategorySlot {
  id                String          @id @default(cuid())
  projectCategoryId String
  projectCategory   ProjectCategory @relation(fields: [projectCategoryId], references: [id], onDelete: Cascade)
  sortOrder         Int
  projectGroupId    String?         @unique
  projectGroup      ProjectGroup?   @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)
  subHireGroupId    String?         @unique
  subHireGroup      SubHireGroup?   @relation(fields: [subHireGroupId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([projectCategoryId, sortOrder])
  @@index([projectCategoryId])
  @@map("category_slot")
}

// ─── Project Group ──────────────────────────────────────────────────────────

model ProjectGroup {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Nullable since v0.9.4.0 — groups can live in the project's
  // Uncategorized zone, mirroring SubHireGroup.targetCategoryId.
  // The relation's onDelete switched from Cascade to SetNull so
  // deleting a category no longer destroys its groups; they
  // become orphaned and surface in the Uncategorized zone.
  categoryId     String?
  category       ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  quantity       Int             @default(1)
  price          Decimal?        @db.Decimal(12, 2)
  suggestedPrice Decimal?        @db.Decimal(12, 2)
  rentalPeriod   RentalPeriod?
  rentalQuantity Int?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lineItems           ProjectLineItem[]
  // Sub-hire placement targets
  subHireDefaults     SubHire[]         @relation("SubHireDefaultTargetGroup")
  subHireGroupTargets SubHireGroup[]    @relation("SubHireGroupTargetGroup")
  subHireItemTargets  SubHireItem[]     @relation("SubHireItemTargetGroup")
  // Cross-type category ordering. At most one slot per group; created when the
  // group is placed in a category (which all ProjectGroups are).
  slot                CategorySlot?

  @@index([projectId])
  @@index([categoryId])
  @@index([organizationId])
  @@map("project_group")
}

