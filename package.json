{
  "name": "rvlt-flow",
  "version": "0.25.4",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "depcruise": "depcruise src convex --config .dependency-cruiser.cjs --ignore-known",
    "depcruise-ratchet": "node scripts/depcruise-ratchet.mjs",
    "any-ratchet": "bash scripts/any-ratchet.sh",
    "collect-ratchet": "node scripts/collect-ratchet.mjs",
    "knip-ratchet": "node scripts/knip-ratchet.mjs",
    "complexity-ratchet": "node scripts/complexity-ratchet.mjs",
    "hotspots": "node scripts/hotspots.mjs",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "INTEGRATION_CONVEX=1 DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearflow_test BETTER_AUTH_URL=https://preview.lab.rvlt.app NEXT_PUBLIC_CONVEX_URL=https://groovy-koala-475.convex.cloud vitest run --config vitest.integration.config.ts",
    "test:integration:pg": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearflow_test vitest run --config vitest.integration.config.ts",
    "lint:server-actions": "tsx scripts/audit-server-actions.ts",
    "api:registry": "tsx scripts/generate-api-registry.mts",
    "api:registry:check": "tsx scripts/generate-api-registry.mts --check",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "convex:schema": "node scripts/generate-convex-schema.cjs .",
    "convex:crud": "node scripts/generate-convex-crud.cjs .",
    "convex:backfill:dashboard-counters": "tsx --env-file=.env --env-file=.env.local scripts/convex-backfill-dashboard-counters.ts",
    "convex:backfill:revenue-allocation": "tsx --env-file=.env --env-file=.env.local scripts/convex-backfill-revenue-allocation.ts",
    "convex:auth:roundtrip": "tsx --env-file=.env --env-file=.env.local scripts/convex-auth-roundtrip.ts",
    "prepare": "husky || true",
    "check-client-routes": "node scripts/check-client-routes.mjs",
    "bundle-ratchet": "node scripts/bundle-ratchet.mjs",
    "check-migration-drift": "node scripts/check-migration-drift.mjs",
    "check-docs-npm-npx": "node scripts/check-docs-npm-npx.mjs",
    "check-dependency-justification": "node scripts/check-dependency-justification.mjs",
    "check-docs-review-cadence": "node scripts/check-docs-review-cadence.mjs",
    "pr-size-check": "node scripts/pr-size-check.mjs"
  },
