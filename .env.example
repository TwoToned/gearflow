# RVLT Flow environment — copy to .env and fill in. Required vars are validated at
# boot by src/env.ts; a missing one fails loudly. See CLAUDE.md for the full list.

# ── Core (required) ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gearflow?schema=public"
BETTER_AUTH_SECRET="change-me-use-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── DB connection hardening (optional, safe defaults — see src/lib/db-url.ts) ──
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_POOL_TIMEOUT_S=10
# DB_CONNECTION_LIMIT=

# ── Email (Resend; logs to console if unset) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="RVLT Flow <flow@rvlt.app>"
# NATIVE_EMAIL_SIDEEFFECTS=true

# ── File uploads (bytes are stored in Convex file storage; no S3/MinIO) ───────
UPLOAD_MAX_SIZE_MB=50

# ── Auth / branding ───────────────────────────────────────────────────────────
PASSKEY_RP_ID=localhost
PLATFORM_NAME=RVLT Flow
# ADMIN_REGISTRATION_TOKEN / SITE_ADMIN_SECRET_TOKEN — admin registration token
SITE_ADMIN_SECRET_TOKEN=change-me-at-least-32-chars
SITE_ADMIN_REGISTRATION_ENABLED=true
# NEXT_PUBLIC_SITE_ADMIN_REG_ENABLED=true

# ── Google Maps ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Cron (optional) ────────────────────────────────────────────────────────────
# CRON_SECRET=

# ── Analytics + error tracking (PostHog, optional) ────────────────────────────
# Public write-only ingestion key (phc_…) — safe to expose; browser needs the
# NEXT_PUBLIC_ copy (inlined at build). Analytics + client/server exception
# capture are inert if the key is unset.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Sourcemap upload (deploy pipeline only — NOT needed for local dev/pnpm build,
# see next.config.ts POSTHOG_SOURCEMAPS_REQUIRED gate). A personal API key with
# `error tracking write` + `organization read` scopes:
# POSTHOG_CLI_TOKEN=
# POSTHOG_CLI_ENV_ID=520134

# ── Convex (Convex Cloud — self-hosted backend is decommissioned) ─────────────
# Production runs on Convex Cloud. There's also a SHARED DEV deployment used by
# PR previews. Push function changes with `pnpm exec convex dev --once`
# (CONVEX_DEPLOY_KEY must be set). The CONVEX_SELF_HOSTED_* vars are obsolete.
#
# Point the browser client at the dev deployment's URL (find it in the Convex
# dashboard → dev deployment). NEXT_PUBLIC_* is inlined into the bundle at build.
NEXT_PUBLIC_CONVEX_URL=https://<your-dev-deployment>.convex.cloud
# CONVEX_SITE_URL is for Convex HTTP actions — only set if you use them.
# NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-dev-deployment>.convex.site
# Deploy key for `convex dev --once` / `convex deploy` (Convex dashboard → Settings).
CONVEX_DEPLOY_KEY=
# Convex-side cron dispatch — set ON THE CONVEX DEPLOYMENT (dashboard env vars),
# NOT in this file. Dormant until ENABLE_CONVEX_CRONS=true (see convex/crons.ts).
# ENABLE_CONVEX_CRONS=true
# CONVEX_CRON_TARGET_URL=https://flow.rvlt.app

# Auth bridge. These are set ON THE
# CONVEX DEPLOYMENT (dashboard env vars), NOT in this file — convex/auth.config.ts
# reads them at push time. ISSUER must EXACTLY equal the JWT `iss` (= the app's
# BETTER_AUTH_URL); JWKS_URL must be PUBLICLY reachable by Convex Cloud's servers.
# The shared dev deployment is pinned to the always-on preview app:
#   CONVEX_AUTH_ISSUER   = https://preview.lab.rvlt.app
#   CONVEX_AUTH_JWKS_URL = https://preview.lab.rvlt.app/api/auth/jwks
#
# LOCAL DEV against the shared dev Convex without waiting for Coolify: copy
# .env.local.example → .env.local. It "lies about the domain" (BETTER_AUTH_URL=
# https://preview.lab.rvlt.app) so locally-minted tokens validate against the
# shared deployment's JWKS. See that file for the full recipe + trade-offs.
