  // Cross-type category ordering. Optional — sub-hire groups can live
  // uncategorised (no slot row). When categorised, the slot owns sortOrder
  // across the mixed ProjectGroup + SubHireGroup list in that category.
  slot             CategorySlot?

  @@index([subHireId])
  @@map("sub_hire_group")
}

