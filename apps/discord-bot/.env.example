# GearFlow Discord bot — copy to .env and fill in. See README.md for setup steps.

# Discord application (Developer Portal)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# GearFlow connection
GEARFLOW_API_URL=https://home.twotoned.com.au
# Global bearer the app uses to gate the outbox pull (matches app env DISCORD_BOT_TOKEN)
GEARFLOW_BOT_BEARER=
# Per-org HMAC secret — generated in GearFlow → Settings → Discord (DiscordIntegration.signingSecret)
GEARFLOW_DISCORD_SIGNING_SECRET=
# The GearFlow organisation this bot process serves (single-org per process for v1).
# Find it in the URL after picking the org, or `select id from "organization";` in the DB.
GEARFLOW_ORG_ID=

# Optional — outbox poll cadence (also drives the heartbeat the admin page reads).
# Default 5000 (5s). Minimum 500.
# POLL_INTERVAL_MS=5000
