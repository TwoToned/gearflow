generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Core Tables ─────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user") // "user" or "admin" (site-level)
  banned        Boolean?
  banReason     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth 2FA fields
  twoFactorEnabled Boolean?

  sessions Session[]
  accounts Account[]
  members  Member[]

  // App relations
  twoFactors                TwoFactor[]
  backupCodes               BackupCode[]
  activityLogs              ActivityLog[]
  passkeys                  Passkey[]
  ssoProviders              SsoProvider[]
  pendingSSOApprovals       PendingSSOApproval[]
  reviewedSSOApprovals      PendingSSOApproval[]        @relation("SSOReviewer")
  apiKeysActingAs           ApiKey[]                    @relation("ApiKeyActingUser")
  createdApiKeys            ApiKey[]                    @relation("ApiKeyCreatedBy")

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Better Auth `jwt()` plugin key storage (Convex Phase 5 auth bridge). Holds the
// ES256 signing keypair used to mint Convex-compatible JWTs (user tokens via
// /api/auth/token, service tokens via auth.api.signJWT). privateKey is encrypted
// with BETTER_AUTH_SECRET. Auth-owned — no Convex CRUD (stays in Prisma forever).
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@map("jwks")
}

// ─── Better Auth Organization Tables ─────────────────────────────────────────

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  metadata       String? // JSON string for extended org settings
  defaultTaxRate Decimal? @db.Decimal(5, 2)

  // Org-wide API kill switch: when set, ALL of this org's API keys are rejected
  // regardless of per-key state (instant blast-radius containment).
  apiKillSwitchAt DateTime?

  // Orgs are archived, never deleted (D12, #1075/A5) — reversible. Enforced at
  // the identity chokepoints (resolveActiveOrganizationId, definePayload,
  // getApiKeyActorContext), not per-query: an archived org's slug is released
  // (rewritten) so a new org can claim it while archived.
  archivedAt DateTime?

  members     Member[]
  invitations Invitation[]

  // App relations
  activityLogs             ActivityLog[]
  ssoProviders             SsoProvider[]
  pendingSSOApprovals      PendingSSOApproval[]
  apiKeys                  ApiKey[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String // owner, admin, manager, staff, warehouse
  createdAt      DateTime     @default(now())

  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String // pending, accepted, rejected, cancelled
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())

  @@map("invitation")
}

// ─── Custom Roles ──────────────────────────────────────────────────────────

// ─── Better Auth SSO Tables ────────────────────────────────────────────────

/// Managed by @better-auth/sso plugin. Mapped here for type-safe Prisma queries.
model SsoProvider {
  id             String        @id @default(cuid())
  issuer         String
  oidcConfig     String? // JSON-encoded OIDC settings
  samlConfig     String? // JSON-encoded SAML settings
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerId     String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain         String
  domainVerified Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([domain])
  @@map("sso_provider")
}

// ─── SSO Approval Workflow ─────────────────────────────────────────────────

enum SSOApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingSSOApproval {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  idpGroups      String[]          @default([])
  suggestedRole  String?
  providerId     String
  status         SSOApprovalStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("SSOReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("pending_sso_approval")
}

