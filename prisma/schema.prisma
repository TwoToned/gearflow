// ─── Serialized Asset ────────────────────────────────────────────────────────

model Asset {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId             String
  model               Model          @relation(fields: [modelId], references: [id])
  assetTag            String
  serialNumber        String?
  customName          String?
  status              AssetStatus    @default(AVAILABLE)
  condition           AssetCondition @default(NEW)
  purchaseDate        DateTime?
  purchasePrice       Decimal?       @db.Decimal(10, 2)
  purchaseSupplier    String?
  supplierId          String?
  supplier            Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderNumber String?
  supplierOrderId     String?
  supplierOrder       SupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  warrantyExpiry      DateTime?
  notes               String?
  locationId          String?
  location            Location?      @relation(fields: [locationId], references: [id])
  customFieldValues   Json?
  lastTestAndTagDate  DateTime?
  nextTestAndTagDate  DateTime?
  barcode             String?
  qrCode              String?
  images              String[]       @default([])
  tags                String[]       @default([])
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  kitId   String?
  kit     Kit?               @relation(fields: [kitId], references: [id])
  kitItem KitSerializedItem?

  // Child assets / accessories — a serialised asset can be permanently
  // attached to a parent serialised asset (e.g. an IEC cable on a mixer).
  // parentAssetId is single-valued: a child has exactly one parent.
  parentAssetId  String?
  parentAsset    Asset?           @relation("AssetAccessories", fields: [parentAssetId], references: [id], onDelete: SetNull)
  childAssets    Asset[]          @relation("AssetAccessories")
  childBulkItems AssetBulkChild[]

  maintenanceLinks   MaintenanceRecordAsset[]
  lineItems          ProjectLineItem[]
  lineItemUnits      ProjectLineItemUnit[]
  scanLogs           AssetScanLog[]
  media              AssetMedia[]
  testTagAsset       TestTagAsset?
  supplierOrderItems SupplierOrderItem[]
  checkRecords       CheckRecord[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([status])
  @@index([modelId])
  @@index([locationId])
  @@index([supplierId])
  @@index([supplierOrderId])
  @@index([kitId])
  @@index([parentAssetId])
  @@index([isActive])
  @@map("asset")
}

// ─── Bulk Asset ──────────────────────────────────────────────────────────────

model BulkAsset {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId              String
  model                Model           @relation(fields: [modelId], references: [id])
  assetTag             String
  totalQuantity        Int             @default(0)
  availableQuantity    Int             @default(0)
  purchasePricePerUnit Decimal?        @db.Decimal(10, 2)
  locationId           String?
  location             Location?       @relation(fields: [locationId], references: [id])
  status               BulkAssetStatus @default(ACTIVE)
  notes                String?
  tags                 String[]        @default([])
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  kitBulkItems       KitBulkItem[]
  assetChildItems    AssetBulkChild[]
  modelAccessoryUses ModelBulkAccessory[]
  lineItems          ProjectLineItem[]
  lineItemUnits      ProjectLineItemUnit[]
  scanLogs        AssetScanLog[]
  testTagAssets   TestTagAsset[]
  checkRecords    CheckRecord[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([status])
  @@index([modelId])
  @@index([isActive])
  @@map("bulk_asset")
}

/// How a bulk accessory is allocated against the shared pool.
/// SHIPS_WITH: the parent "ships with" N of this bulk asset; the N are drawn
///   from the live pool at prep/checkout (a normal booking) — availability is
///   computed live, the pool is NOT decremented at attach time.
/// DEDICATED: the N are permanently pulled out of the shared pool at attach
///   time (kit-style availableQuantity decrement) and restored on detach/remove.
enum AccessoryAllocationMode {
  SHIPS_WITH
  DEDICATED
}

/// A bulk asset attached as a permanent accessory to a parent serialised asset
/// (e.g. "this light ships with 2 clamps"). Mirrors KitBulkItem.
model AssetBulkChild {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentAssetId  String
  parentAsset    Asset                   @relation(fields: [parentAssetId], references: [id], onDelete: Cascade)
  bulkAssetId    String
  bulkAsset      BulkAsset               @relation(fields: [bulkAssetId], references: [id], onDelete: Cascade)
  quantity       Int
  allocationMode AccessoryAllocationMode @default(SHIPS_WITH)
  sortOrder      Int                     @default(0)
  notes          String?
  addedAt        DateTime                @default(now())
  addedById      String
  addedBy        User                    @relation("AssetBulkChildAddedBy", fields: [addedById], references: [id])

  @@index([organizationId])
  @@index([parentAssetId])
  @@index([bulkAssetId])
  @@map("asset_bulk_child")
}

/// A bulk asset declared as a default accessory at the Model level —
/// "every asset of this model ships with N of this bulk asset". When any
/// asset of the model is added to a project, model-level bulk accessories
/// auto-expand as child lines alongside the asset's own accessories, deduped
/// by bulkAssetId (asset-level wins on conflict). Model-level accessories are
/// always SHIPS_WITH (drawn from the live pool at prep) — DEDICATED only
/// makes sense at the asset level (you can't permanently reserve N from the
/// pool against every asset of a model — that'd drain the whole shelf).
model ModelBulkAccessory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId        String
  model          Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  bulkAssetId    String
  bulkAsset      BulkAsset    @relation(fields: [bulkAssetId], references: [id], onDelete: Cascade)
  quantity       Int
  sortOrder      Int          @default(0)
  notes          String?
  addedAt        DateTime     @default(now())
  addedById      String
  addedBy        User         @relation("ModelBulkAccessoryAddedBy", fields: [addedById], references: [id])

  @@unique([modelId, bulkAssetId])
  @@index([organizationId])
  @@index([modelId])
  @@index([bulkAssetId])
  @@map("model_bulk_accessory")
}

