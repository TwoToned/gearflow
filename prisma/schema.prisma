// ─── Section Presets (reusable custom sections across templates) ──────────────

model SectionPreset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String // e.g. "Bank Details", "Terms & Conditions"
  description String? // optional description
  sections    String   @db.Text // JSON — TemplateSection[] (one or more sections)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@map("section_preset")
}

// ─── Warehouse Dashboard Display ─────────────────────────────────────────────

model WarehouseDashboardToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String // "Main Warehouse TV", "Loading Dock Screen"
  token      String // Raw access token (for URL display in settings)
  tokenHash  String    @unique // SHA-256 of the access token (for lookup)
  locationId String? // Scope to a specific warehouse location
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  layout     String    @default("standard") // "standard", "compact", "dispatch-only"

  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("warehouse_dashboard_token")
}

// ─── Test & Tag Auditor Portal ───────────────────────────────────────────────

model TestTagAuditorToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String // "Insurance Auditor", "Annual Compliance Check"
  token     String // Raw access token (displayed in settings)
  tokenHash String    @unique // SHA-256 for secure lookup
  isActive  Boolean   @default(true)
  expiresAt DateTime? // Optional expiry date
  scope     String? // JSON: { categories?, equipmentClasses?, locations?, assetIds? }

  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("test_tag_auditor_token")
}

// ─── WooCommerce Integration ─────────────────────────────────────────────────

model WooCommerceIntegration {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isEnabled     Boolean @default(false)
  webhookSecret String // Shared secret for HMAC verification
  storeUrl      String? // WooCommerce store URL (for reference/display)

  // Matching strategy
  productMatchField String  @default("sku") // "sku", "custom_field", "name"
  customFieldKey    String? // If productMatchField = "custom_field", which meta key

  // Date field mapping (WooCommerce meta_data keys → project fields)
  rentalStartKey     String? // e.g. "rental_start_date"
  rentalEndKey       String? // e.g. "rental_end_date"
  eventStartKey      String? // e.g. "event_date"
  deliveryAddressKey String? // e.g. "delivery_address"
  notesKey           String? // e.g. "order_notes" or "customer_note"

  // Date format preference
  dateFormat String @default("auto") // "auto", "DD/MM/YYYY", "MM/DD/YYYY", "ISO"

  // Location mapping
  locationMetaKey   String? // WooCommerce meta key containing venue/location name
  defaultLocationId String? // Fallback location if no meta key match

  // Defaults for created projects
  defaultProjectType String  @default("DRY_HIRE")
  autoConfirmEnquiry Boolean @default(false) // If true, set status to QUOTING instead of ENQUIRY

  // Notification
  notifyUserIds String[] @default([]) // User IDs to notify on new website orders

  // Last webhook payload (for "Test & Detect" feature)
  lastPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("woocommerce_integration")
}

model WooCommerceOrderLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  wooOrderId     Int // WooCommerce order ID
  wooOrderNumber String? // WooCommerce order number (may differ from ID)
  status         WooOrderLogStatus // RECEIVED, PROCESSING, COMPLETED, FAILED, DUPLICATE

  // What was created
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId  String?

  // Debugging
  payload        Json // Full webhook payload (for debugging)
  errorMessage   String? // If FAILED
  matchResults   Json? // Which products matched which models
  dateExtraction Json? // Date parsing results for display

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([wooOrderId])
  @@map("woocommerce_order_log")
}

enum WooOrderLogStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
}

}

// ─── Check Item System ───────────────────────────────────────────────────────

model CheckItem {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label           String
  description     String?
  type            CheckItemType @default(PASS_FAIL)
  category        String?
  measurementUnit String? // for MEASUREMENT type (e.g. "mm", "kg", "V")
  measurementMin  Float? // pass threshold minimum
  measurementMax  Float? // pass threshold maximum
  dropdownOptions Json? // for DROPDOWN type: { label: string, isFail: boolean }[]
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  modelCheckItems ModelCheckItem[]
  kitCheckItems   KitCheckItem[]
  checkRecords    CheckRecord[]

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("check_item")
}

model ModelCheckItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId        String
  model          Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  checkItemId    String
  checkItem      CheckItem    @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([modelId, checkItemId])
  @@index([organizationId])
  @@index([organizationId, modelId])
  @@map("model_check_item")
}

model KitCheckItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitId          String
  kit            Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  checkItemId    String
  checkItem      CheckItem    @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([kitId, checkItemId])
  @@index([organizationId])
  @@index([organizationId, kitId])
  @@map("kit_check_item")
}

model CheckRecord {
  id                     String               @id @default(cuid())
  organizationId         String
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  context                CheckContext
  lineItemId             String? // null for AD_HOC
  lineItem               ProjectLineItem?     @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  lineItemUnitId         String?
  lineItemUnit           ProjectLineItemUnit? @relation(fields: [lineItemUnitId], references: [id], onDelete: SetNull)
  assetId                String? // null when no serialized asset assigned
  asset                  Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  bulkAssetId            String? // for bulk asset checks
  bulkAsset              BulkAsset?           @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)
  kitId                  String? // for kit-level checks
  kit                    Kit?                 @relation(fields: [kitId], references: [id], onDelete: SetNull)
  checkItemId            String
  checkItem              CheckItem            @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  checkItemLabelSnapshot String
  checkItemTypeSnapshot  CheckItemType
  result                 CheckResult
  value                  String? // measurement reading or dropdown selection
  notes                  String?
  photos                 String[]             @default([]) // S3 keys
  performedById          String
  performedBy            User                 @relation("CheckRecordPerformedBy", fields: [performedById], references: [id], onDelete: Cascade)
  performedAt            DateTime             @default(now())

  @@index([organizationId])
  @@index([organizationId, assetId])
  @@index([organizationId, checkItemId])
  @@index([lineItemId])
  @@index([lineItemUnitId])
  @@map("check_record")
}

model WarehouseClose {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedById     String
  closedBy       User         @relation("WarehouseClosedBy", fields: [closedById], references: [id], onDelete: Cascade)
  closedAt       DateTime     @default(now())
  storedCount    Int          @default(0)
  damagedCount   Int          @default(0)
  lostCount      Int          @default(0)

  @@unique([projectId, organizationId])
  @@index([organizationId])
  @@map("warehouse_close")
}

// ─── Notifications ───────────────────────────────────────────────────────────

/**
 * Per-user dismissal record for a computed-on-read notification. Notifications
 * themselves are not persisted — they're derived from app state. This table
 * stores which notification keys a given user has already dismissed so the
 * dismissal persists across browsers / cleared localStorage.
 * notificationKey is the stable identifier the server uses for the notification
 * (e.g. `maint-<id>`, `return-<id>`, `low_stock:<id>`, etc.). Keys are scoped
 * by user; if the same notification re-fires for a new entity instance it gets
 * a different key and re-surfaces.
 */
model NotificationDismissal {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationKey String
  dismissedAt     DateTime     @default(now())

  @@unique([userId, notificationKey])
  @@index([organizationId, userId])
  @@map("notification_dismissal")
}

/**
 * Per-user opt-in flags for email delivery of in-app notifications. One row
 * per user, lazily created the first time they visit the preferences UI.
 * Defaults are intentionally conservative — only the high-signal actionable
 * events default to ON (overdue maintenance / returns, low stock, invitations,
 * expiring certs, flagged assets).
 */
model UserNotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  overdueMaintenance Boolean @default(true)
  overdueReturn      Boolean @default(true)
  upcomingProject    Boolean @default(false)
  lowStock           Boolean @default(true)
  pendingInvitation  Boolean @default(true)
  expiringCert       Boolean @default(true)
  pendingOffers      Boolean @default(false)
  pendingTimesheets  Boolean @default(false)
  flaggedAsset       Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("user_notification_preference")
}

/**
 * Dedupe ledger for outbound notification emails. We don't want to re-email
 * the same user about the same notification every time the cron fires — one
 * row per (user, notificationKey) means "this user has been emailed about
 * this thing at least once." Cleared lazily by pruneStaleNotificationLogs.
 */
model NotificationEmailLog {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationKey String
  sentAt          DateTime     @default(now())

  @@unique([userId, notificationKey])
  @@index([organizationId, sentAt])
  @@map("notification_email_log")
}

// ─── Custom Fields (operator-defined entity attributes) ─────────────────────

/**
 * Org-defined custom fields. Each definition adds an input to an entity's
 * create/edit form; the value is stored in that entity's existing
 * `customFieldValues` JSON column keyed by `fieldKey`.
 * entityType is an enum for forward-compat — v1 wires ASSET only; KIT /
 * PROJECT / BULK_ASSET follow once they all carry a values column.
 */
model CustomFieldDefinition {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     CustomFieldEntity @default(ASSET)
  /**
   * Human label shown on the form, e.g. "Rig Number".
   */
  label          String
  /**
   * Stable machine key into the customFieldValues JSON. Immutable once set.
   */
  fieldKey       String
  fieldType      CustomFieldType   @default(TEXT)
  /**
   * Choices for SELECT type. Empty for other types.
   */
  options        String[]          @default([])
  required       Boolean           @default(false)
  helpText       String?
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId, entityType])
  @@map("custom_field_definition")
}

enum CustomFieldEntity {
  ASSET
  BULK_ASSET
  KIT
  PROJECT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

// ─── Project Number Sequences (auto-incrementing project codes) ──────────────
// One counter row per (org, scopeKey). scopeKey buckets the increment by the
// configured reset period (e.g. "2026-06" monthly, "2026" yearly, "GLOBAL" none).
// Incremented atomically via INSERT ... ON CONFLICT so concurrent project
// creation can't hand out duplicate numbers.
model ProjectNumberSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scopeKey       String
  value          Int          @default(0)

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([organizationId, scopeKey])
  @@map("project_number_sequence")
}

// ─── Project Tasks (Asana-style per-project to-do list) ──────────────────────
model ProjectTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      ProjectTaskStatus @default(TODO)
  priority    ProjectTaskPriority @default(NORMAL)
  dueDate     DateTime?
  // Manual ordering within a project's list (drag/sort). Lower = higher.
  sortOrder   Int               @default(0)
  // Optional sub-steps: [{ id, text, done }] — kept inline as JSON, not a table.
  checklist   Json?

  // Assignee is EITHER an org user OR a crew member (at most one). Both nullable.
  assigneeUserId String?
  assigneeUser   User?       @relation("ProjectTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeCrewId String?
  assigneeCrew   CrewMember? @relation("ProjectTaskCrewAssignee", fields: [assigneeCrewId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?     @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId])
  @@index([projectId, status])
  @@index([assigneeUserId, status])
  @@map("project_task")
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ProjectTaskPriority {
  LOW
  NORMAL
  HIGH
}

// ─── Prep System (Pre-Packing / Staging) ─────────────────────────────────────

// ─── Saved Table Views (per-user, org-scoped list filter/sort/column presets) ─
model SavedTableView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Logical list identifier (matches useTablePreferences tableId), e.g. "assets",
  // "clients", "projects". A view only ever applies to its own table.
  tableId   String
  name      String
  // SavedViewConfig JSON: { filters, sortBy, sortOrder, columnVisibility, pageSize }.
  config    Json
  // At most one default per (user, tableId); enforced in the server action, not the DB.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, tableId, name])
  @@index([userId, tableId])
  @@index([organizationId])
  @@map("saved_table_view")
}
