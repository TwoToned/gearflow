  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("crew_member")
}

enum CrewMemberType {
  EMPLOYEE
  FREELANCER
  CONTRACTOR
  VOLUNTEER
}

enum CrewMemberStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  ARCHIVED
}

model CrewRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  department  String?
  color       String?
  defaultRate Decimal?      @db.Decimal(10, 2)
  rateType    CrewRateType?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)

  crewMembers     CrewMember[]
  assignments     CrewAssignment[]
  projectServices ProjectService[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("crew_role")
}

enum CrewRateType {
  HOURLY
  DAILY
  FLAT
}

model CrewSkill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  category String?

  crewMembers CrewMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("crew_skill")
}

model CrewAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  crewMemberId String
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  crewRoleId String?
  crewRole   CrewRole? @relation(fields: [crewRoleId], references: [id], onDelete: SetNull)

  status           AssignmentStatus @default(PENDING)
  phase            ProjectPhase?
  isProjectManager Boolean          @default(false)

  // Schedule
  startDate DateTime?
  startTime String?
  endDate   DateTime?
  endTime   String?

  // Rate
  rateOverride   Decimal?      @db.Decimal(10, 2)
  rateType       CrewRateType?
  estimatedHours Decimal?      @db.Decimal(6, 2)
  estimatedCost  Decimal?      @db.Decimal(10, 2)

  // Notes
  notes         String?
  internalNotes String?

  // Response tracking
  responseToken String?   @unique
  offeredAt     DateTime?
  respondedAt   DateTime?
  responseNote  String?

  // Confirmation
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Service link (when assigned via a ProjectService)
  serviceId String?
  service   ProjectService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  shifts      CrewShift[]
  timeEntries CrewTimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Partial unique index created via raw SQL migration:
  // UNIQUE(projectId, crewMemberId, serviceId) WHERE serviceId IS NOT NULL
  @@index([organizationId])
  @@index([projectId])
  @@index([crewMemberId])
  @@index([crewMemberId, startDate])
  @@index([crewMemberId, startDate, endDate])
  @@index([serviceId])
  @@map("crew_assignment")
}

enum AssignmentStatus {
  PENDING
  OFFERED
  ACCEPTED
  DECLINED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ProjectPhase {
  BUMP_IN
  EVENT
  BUMP_OUT
  DELIVERY
  PICKUP
  SETUP
  REHEARSAL
  FULL_DURATION
}

model CrewShift {
