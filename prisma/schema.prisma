// ─── API / MCP access keys ───────────────────────────────────────────────────
// Hardened, org-scoped bearer keys for the agent-accessible API + MCP layer.
// Generalizes the TestTagAuditorToken pattern: hash-only (no raw token stored),
// a display `prefix`, resource:action `scopes`, and an `actingUser` whose live
// RBAC bounds the key. See docs/designs/api-mcp-agent-access.md.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String // Human label, e.g. "Booking agent (Claude)"
  prefix    String // Non-secret display prefix, e.g. "gf_live_ab12" (first chars of the key)
  tokenHash String  @unique // SHA-256 of the full secret — the ONLY copy we keep
  scopes    String  @default("[]") // JSON array of resource:action strings, e.g. ["assets:read","project:manage_line_items"]
  isActive  Boolean @default(true)

  // The user this key acts AS. Effective permission = intersection(this user's
  // live RBAC, `scopes`). Deactivating/demoting the user immediately narrows the key.
  actingUserId String
  actingUser   User   @relation("ApiKeyActingUser", fields: [actingUserId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  expiresAt     DateTime? // Optional hard expiry
  lastUsedAt    DateTime? // Updated on each successful auth (observability)
  lastRotatedAt DateTime? // Set when the secret is rotated
  revokedAt     DateTime? // Set on single-key revocation (isActive also flipped false)
  createdAt     DateTime  @default(now())

  @@index([organizationId])
  @@index([actingUserId])
  @@map("api_key")
}

// Idempotency ledger for API writes. A committed capability verb records its
// result keyed by (apiKeyId, idempotencyKey); a retry with the same key returns the
// stored result instead of re-executing — so a retried "reserve 3x" produces ONE
// reservation, not three. See docs/designs/api-mcp-agent-access.md.
model ApiIdempotency {
  id             String   @id @default(cuid())
  organizationId String
  // apiKeyId is a plain external id now — ApiKey is a Convex domain, so the FK to
  // api_key was dropped (migration 20260713120000). No Prisma relation.
  apiKeyId       String
  key            String // client-provided idempotency key
  verb           String // capability verb, e.g. "reserve_items"
  result         String // JSON-serialized result returned on replay
  createdAt      DateTime @default(now())

  @@unique([apiKeyId, key])
  @@index([organizationId])
  @@map("api_idempotency")
}

