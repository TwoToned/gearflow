// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  parentId       String?
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  description    String?
  icon           String?
  sortOrder      Int          @default(0)
  tags               String[]     @default([])
  suggestedCrewRoles String[]     @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  models     Model[]
  kits       Kit[]

  @@index([organizationId])
  @@index([parentId])
  @@map("category")
}

// ─── Model (Equipment Template) ──────────────────────────────────────────────

model Model {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                    String
  manufacturer            String?
  modelNumber             String?
  sku                     String?
  categoryId              String?
  category                Category?    @relation(fields: [categoryId], references: [id])
  description             String?
  image                   String?
  images                  String[]     @default([])
  manuals                 String[]     @default([])
  specifications          Json?        // key-value pairs
  customFields            Json?        // org-defined fields inherited by assets
  defaultRentalPrice      Decimal?     @db.Decimal(10, 2)
  dailyRate               Decimal?     @db.Decimal(10, 2)
  weeklyRate              Decimal?     @db.Decimal(10, 2)
  monthlyRate             Decimal?     @db.Decimal(10, 2)
  defaultPurchasePrice    Decimal?     @db.Decimal(10, 2)
  replacementCost         Decimal?     @db.Decimal(10, 2)
  weight                  Decimal?     @db.Decimal(8, 2)
  powerDraw               Int?
  requiresTestAndTag         Boolean         @default(false)
  testAndTagIntervalDays     Int?
  defaultEquipmentClass      EquipmentClass?
  defaultApplianceType       ApplianceType?
  defaultTestProfileId       String?
  defaultTestProfile         TestProfile?    @relation("ModelDefaultTestProfile", fields: [defaultTestProfileId], references: [id], onDelete: SetNull)
  maintenanceIntervalDays    Int?
  assetType               AssetType    @default(SERIALIZED)
  barcodeLabelTemplate    String?
  tags                    String[]     @default([])
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  assets              Asset[]
  bulkAssets          BulkAsset[]
  lineItems           ProjectLineItem[]
  media               ModelMedia[]
  modelCheckItems     ModelCheckItem[]
  groupTemplateItems  GroupTemplateItem[]

  supplierOrderItems  SupplierOrderItem[]
  subHireItems        SubHireItem[]
  supplierModelRates  SupplierModelRate[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@index([isActive])
  @@map("model")
}

// ─── Supplier ───────────────────────────────────────────────────────────────

model Supplier {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  contactName     String?
  email           String?
  phone           String?
  website         String?
  address         String?
  latitude        Float?
  longitude       Float?
  notes           String?
  accountNumber   String?
  paymentTerms    String?
  defaultLeadTime String?
  tags            String[]     @default([])
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assets    Asset[]
  lineItems ProjectLineItem[]
  orders    SupplierOrder[]
  subHires  SubHire[]
  supplierModelRates SupplierModelRate[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("supplier")
}

// ─── Supplier Orders ────────────────────────────────────────────────────────

model SupplierOrder {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderNumber     String
  type            SupplierOrderType
  status          SupplierOrderStatus @default(DRAFT)
  orderDate       DateTime?
  expectedDate    DateTime?
  receivedDate    DateTime?
  subtotal        Decimal?            @db.Decimal(10, 2)
  taxAmount       Decimal?            @db.Decimal(10, 2)
  total           Decimal?            @db.Decimal(10, 2)
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes           String?
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items           SupplierOrderItem[]
  assets          Asset[]
  lineItems       ProjectLineItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, supplierId])
  @@index([organizationId, orderNumber])
  @@map("supplier_order")
}

model SupplierOrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       SupplierOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal?       @db.Decimal(10, 2)
  lineTotal   Decimal?       @db.Decimal(10, 2)
  modelId     String?
  model       Model?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  assetId     String?
  asset       Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  notes       String?
  sortOrder   Int            @default(0)

  @@index([orderId])
  @@map("supplier_order_item")
}

// ─── Sub-Hire (Renting gear from third-party suppliers) ─────────────────────

model SubHire {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  orderNumber     String
  supplierReference String?     // Supplier's invoice/order/PO number
  status          SubHireStatus @default(DRAFT)
  hireStart       DateTime?
  hireEnd         DateTime?
  totalCost       Decimal       @default(0) @db.Decimal(10, 2)
  totalCharge     Decimal       @default(0) @db.Decimal(10, 2)
  pricingMode     SubHirePricingMode @default(ITEMIZED)
  orderTotalCost  Decimal?      @db.Decimal(10, 2)
  orderTotalCharge Decimal?     @db.Decimal(10, 2)
  showOnDocs      Boolean       @default(false) // Default for new items
  paymentStatus   SubHirePaymentStatus @default(UNPAID)
  notes           String?
  // Default placement for items that don't override
  defaultTargetCategoryId  String?
  defaultTargetCategory    ProjectCategory? @relation(fields: [defaultTargetCategoryId], references: [id], onDelete: SetNull)
  defaultTargetGroupId     String?
  defaultTargetGroup       ProjectGroup?    @relation("SubHireDefaultTargetGroup", fields: [defaultTargetGroupId], references: [id], onDelete: SetNull)
  groups          SubHireGroup[]
  items           SubHireItem[]
  lineItems       ProjectLineItem[]
  media           SubHireMedia[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@map("sub_hire")
}

model SubHireItem {
  id           String         @id @default(cuid())
  subHireId    String
  subHire      SubHire        @relation(fields: [subHireId], references: [id], onDelete: Cascade)
  groupId      String?
  group        SubHireGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  modelId      String?
  model        Model?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  description  String
  quantity     Int            @default(1)
  unitCost     Decimal        @default(0) @db.Decimal(10, 2)
  unitCharge   Decimal        @default(0) @db.Decimal(10, 2)
  pricingType  PricingType    @default(FLAT)
  duration     Int            @default(1)
  discount     Decimal        @default(0) @db.Decimal(5, 2)
  showOnQuote  Boolean        @default(true)  // Whether item appears on client quote/invoice
  showOnDocs   Boolean        @default(false) // Whether to show "sub-hired" label on client docs
  sortOrder    Int            @default(0)
  // Placement on project (ungrouped items only; grouped items use their group's target)
  targetCategoryId  String?
  targetCategory    ProjectCategory? @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetGroupId     String?
  targetGroup       ProjectGroup?    @relation("SubHireItemTargetGroup", fields: [targetGroupId], references: [id], onDelete: SetNull)
  lineItems    ProjectLineItem[]

  @@index([subHireId])
  @@index([groupId])
  @@index([modelId])
  @@map("sub_hire_item")
}

model SubHireGroup {
  id          String          @id @default(cuid())
  subHireId   String
  subHire     SubHire         @relation(fields: [subHireId], references: [id], onDelete: Cascade)
  title       String
  sortOrder   Int             @default(0)
  // Pricing — cost (supplier) and charge (client), both optional overrides
  quantity    Int             @default(1)
  cost        Decimal?        @db.Decimal(12, 2)
  charge      Decimal?        @db.Decimal(12, 2)
  showOnQuote Boolean         @default(true)  // Whether group items appear on client quote/invoice
  showOnDocs  Boolean         @default(false) // Whether to show "sub-hired" label on client docs
  // Placement on project (where the group's parent line item lands)
  targetCategoryId  String?
  targetCategory    ProjectCategory? @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetGroupId     String?
  targetGroup       ProjectGroup?    @relation("SubHireGroupTargetGroup", fields: [targetGroupId], references: [id], onDelete: SetNull)
  items       SubHireItem[]
  lineItems   ProjectLineItem[]

  @@index([subHireId])
  @@map("sub_hire_group")
}

model SupplierModelRate {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  modelId         String
  model           Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  lastUnitCost    Decimal      @db.Decimal(10, 2)
  pricingType     PricingType  @default(FLAT)
  lastUsedAt      DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, supplierId, modelId])
  @@index([organizationId, supplierId])
  @@index([organizationId, modelId])
  @@map("supplier_model_rate")
}

// ─── Kit (Physical Container) ────────────────────────────────────────────────

model Kit {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetTag            String
  name                String
  description         String?
  categoryId          String?
  category            Category?      @relation(fields: [categoryId], references: [id])
  status              KitStatus      @default(AVAILABLE)
  condition           AssetCondition @default(NEW)
  locationId          String?
  location            Location?      @relation(fields: [locationId], references: [id])
  weight              Decimal?       @db.Decimal(8, 2)
  caseType            String?
  caseDimensions      String?
  image               String?
  images              String[]       @default([])
  barcode             String?
  qrCode              String?
  notes               String?
  purchaseDate        DateTime?
  purchasePrice       Decimal?       @db.Decimal(10, 2)
  customFieldValues   Json?
  tags                String[]       @default([])
  checkMode           KitCheckMode   @default(KIT_LEVEL)
  isPrep              Boolean        @default(false)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  serializedItems  KitSerializedItem[]
  bulkItems        KitBulkItem[]
  assets           Asset[]
  lineItems        ProjectLineItem[]
  scanLogs         AssetScanLog[]
  maintenanceRecords MaintenanceRecord[]
  media            KitMedia[]
  kitCheckItems    KitCheckItem[]
  checkRecords     CheckRecord[]
  groupTemplateItems GroupTemplateItem[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
  @@index([locationId])
  @@index([isActive])
  @@map("kit")
}

model KitSerializedItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitId          String
  kit            Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  assetId        String       @unique
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position       String?
  sortOrder      Int          @default(0)
  addedAt        DateTime     @default(now())
  addedById      String
  addedBy        User         @relation("KitSerializedItemAddedBy", fields: [addedById], references: [id])
  notes          String?

  @@unique([organizationId, assetId])
  @@index([kitId])
  @@map("kit_serialized_item")
}

model KitBulkItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitId          String
  kit            Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  bulkAssetId    String
  bulkAsset      BulkAsset    @relation(fields: [bulkAssetId], references: [id], onDelete: Cascade)
  quantity       Int
  position       String?
  sortOrder      Int          @default(0)
  addedAt        DateTime     @default(now())
  addedById      String
  addedBy        User         @relation("KitBulkItemAddedBy", fields: [addedById], references: [id])
  notes          String?

  @@index([kitId])
  @@index([bulkAssetId])
  @@map("kit_bulk_item")
}

// ─── Serialized Asset ────────────────────────────────────────────────────────

model Asset {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId             String
  model               Model          @relation(fields: [modelId], references: [id])
  assetTag            String
  serialNumber        String?
  customName          String?
  status              AssetStatus    @default(AVAILABLE)
  condition           AssetCondition @default(NEW)
  purchaseDate        DateTime?
  purchasePrice       Decimal?       @db.Decimal(10, 2)
  purchaseSupplier    String?
  supplierId          String?
  supplier            Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderNumber String?
  supplierOrderId     String?
  supplierOrder       SupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  warrantyExpiry      DateTime?
  notes               String?
  locationId          String?
  location            Location?      @relation(fields: [locationId], references: [id])
  customFieldValues   Json?
  lastTestAndTagDate  DateTime?
  nextTestAndTagDate  DateTime?
  barcode             String?
  qrCode              String?
  images              String[]       @default([])
  tags                String[]       @default([])
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  kitId              String?
  kit                Kit?           @relation(fields: [kitId], references: [id])
  kitItem            KitSerializedItem?

  maintenanceLinks    MaintenanceRecordAsset[]
  lineItems           ProjectLineItem[]
  scanLogs            AssetScanLog[]
  media               AssetMedia[]
  testTagAsset        TestTagAsset?
  supplierOrderItems  SupplierOrderItem[]
  checkRecords        CheckRecord[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([status])
  @@index([modelId])
  @@index([locationId])
  @@index([supplierId])
  @@index([supplierOrderId])
  @@index([kitId])
  @@index([isActive])
  @@map("asset")
}

// ─── Bulk Asset ──────────────────────────────────────────────────────────────

model BulkAsset {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId             String
  model               Model           @relation(fields: [modelId], references: [id])
  assetTag            String
  totalQuantity       Int             @default(0)
  availableQuantity   Int             @default(0)
  purchasePricePerUnit Decimal?       @db.Decimal(10, 2)
  locationId          String?
  location            Location?       @relation(fields: [locationId], references: [id])
  status              BulkAssetStatus @default(ACTIVE)
  reorderThreshold    Int?
  notes               String?
  tags                String[]        @default([])
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  kitBulkItems  KitBulkItem[]
  lineItems     ProjectLineItem[]
  scanLogs      AssetScanLog[]
  testTagAssets TestTagAsset[]
  checkRecords  CheckRecord[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([status])
  @@index([modelId])
  @@index([isActive])
  @@map("bulk_asset")
}

// ─── Location ────────────────────────────────────────────────────────────────

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  type           LocationType @default(WAREHOUSE)
  isDefault      Boolean      @default(false)
  parentId       String?
  parent         Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children       Location[]   @relation("LocationHierarchy")
  notes          String?
  tags           String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assets     Asset[]
  bulkAssets BulkAsset[]
  kits       Kit[]
  projects   Project[]
  media                    LocationMedia[]
  warehouseDashboardTokens WarehouseDashboardToken[]

  @@index([organizationId])
  @@index([parentId])
  @@map("location")
}

// ─── Maintenance Record ──────────────────────────────────────────────────────

model MaintenanceRecord {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitId          String?
  kit            Kit?              @relation(fields: [kitId], references: [id], onDelete: Cascade)
  type           MaintenanceType
  status         MaintenanceStatus @default(SCHEDULED)
  title          String
  description    String?
  reportedById   String?
  reportedBy     User?             @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedToId   String?
  assignedTo     User?             @relation("AssignedTo", fields: [assignedToId], references: [id])
  scheduledDate  DateTime?
  completedDate  DateTime?
  cost           Decimal?          @db.Decimal(10, 2)
  partsUsed      String?
  attachments    String[]          @default([])
  result         MaintenanceResult?
  nextDueDate    DateTime?
  tags           String[]          @default([])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assets MaintenanceRecordAsset[]

  @@index([organizationId])
  @@index([status])
  @@index([scheduledDate])
  @@map("maintenance_record")
}

model MaintenanceRecordAsset {
  id                  String            @id @default(cuid())
  maintenanceRecordId String
  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  assetId             String
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([maintenanceRecordId, assetId])
  @@index([assetId])
  @@map("maintenance_record_asset")
}

// ─── Client ──────────────────────────────────────────────────────────────────

model Client {
  id              String     @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  type            ClientType @default(COMPANY)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  billingAddress    String?
  billingLatitude   Float?
  billingLongitude  Float?
  shippingAddress   String?
  shippingLatitude  Float?
  shippingLongitude Float?
  taxId           String?
  paymentTerms    String?
  defaultDiscount Decimal?   @db.Decimal(5, 2)
  notes           String?
  tags            String[]   @default([])
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projects Project[]
  media    ClientMedia[]

  @@index([organizationId])
  @@index([isActive])
  @@map("client")
}

// ─── Project ─────────────────────────────────────────────────────────────────

model Project {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectNumber     String
  name              String
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id])
  status            ProjectStatus @default(ENQUIRY)
  type              ProjectType   @default(OTHER)
  description        String?
  locationId         String?
  location           Location?    @relation(fields: [locationId], references: [id])
  siteContactName    String?
  siteContactPhone   String?
  siteContactEmail   String?
  loadInDate        DateTime?
  loadInTime        String?
  eventStartDate    DateTime?
  eventStartTime    String?
  eventEndDate      DateTime?
  eventEndTime      String?
  loadOutDate       DateTime?
  loadOutTime       String?
  rentalStartDate   DateTime?
  rentalEndDate     DateTime?
  projectManagerId     String?
  projectManager       User?         @relation("ProjectManager", fields: [projectManagerId], references: [id])
  defaultRentalPeriod  RentalPeriod?
  defaultRentalQuantity Int?
  billingMonths        Int?
  billingWeeks         Int?
  billingDays          Int?
  taxRate              Decimal?      @db.Decimal(5, 2)
  equipmentRevenue     Decimal?      @db.Decimal(12, 2)
  serviceCostTotal     Decimal?      @db.Decimal(12, 2)
  labourCostTotal      Decimal?      @db.Decimal(12, 2)
  subHireCostTotal     Decimal?      @db.Decimal(12, 2)
  margin               Decimal?      @db.Decimal(12, 2)
  crewNotes         String?
  internalNotes     String?
  clientNotes       String?
  subtotal          Decimal?      @db.Decimal(12, 2)
  discountPercent   Decimal?      @db.Decimal(5, 2)
  discountAmount    Decimal?      @db.Decimal(12, 2)
  taxAmount         Decimal?      @db.Decimal(12, 2)
  total             Decimal?      @db.Decimal(12, 2)
  depositPercent    Decimal?      @db.Decimal(5, 2)
  depositPaid       Decimal?      @db.Decimal(12, 2)
  invoicedTotal     Decimal?      @db.Decimal(12, 2)
  tags              String[]      @default([])
  isTemplate        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lineItems        ProjectLineItem[]
  scanLogs         AssetScanLog[]
  media            ProjectMedia[]
  supplierOrders   SupplierOrder[]
  subHires         SubHire[]
  crewAssignments  CrewAssignment[]
  services         ProjectService[]
  wooCommerceOrderLogs WooCommerceOrderLog[]
  warehouseCloses      WarehouseClose[]
  categories       ProjectCategory[]
  groups           ProjectGroup[]
  projectManagers  ProjectManager[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId])
  @@index([status])
  @@index([clientId])
  @@index([locationId])
  @@index([rentalStartDate, rentalEndDate])
  @@index([isTemplate])
  @@map("project")
}

// ─── Project Line Item ───────────────────────────────────────────────────────

model ProjectLineItem {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            LineItemType   @default(EQUIPMENT)
  modelId         String?
  model           Model?         @relation(fields: [modelId], references: [id])
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  bulkAssetId     String?
  bulkAsset       BulkAsset?     @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)
  kitId           String?
  kit             Kit?           @relation(fields: [kitId], references: [id], onDelete: SetNull)
  isKitChild      Boolean        @default(false)
  parentLineItemId String?
  parentLineItem  ProjectLineItem? @relation("KitLineItemChildren", fields: [parentLineItemId], references: [id], onDelete: Cascade)
  childLineItems  ProjectLineItem[] @relation("KitLineItemChildren")
  pricingMode     KitPricingMode?
  description     String?
  quantity         Int           @default(1)
  unitPrice       Decimal?       @db.Decimal(10, 2)
  pricingType     PricingType    @default(PER_DAY)
  duration        Int            @default(1)
  discount        Decimal?       @db.Decimal(10, 2)
  lineTotal       Decimal?       @db.Decimal(12, 2)
  priceBreakdown  String?
  priceOverridden Boolean        @default(false)
  overrideReason  String?
  sortOrder       Int            @default(0)
  groupName       String?
  categoryId      String?
  category        ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  groupId         String?
  group           ProjectGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notes           String?
  isOptional      Boolean        @default(false)
  status              LineItemStatus @default(QUOTED)
  checkedOutQuantity  Int            @default(0)
  returnedQuantity    Int            @default(0)
  checkedOutAt    DateTime?
  checkedOutById  String?
  checkedOutBy    User?          @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  returnedAt      DateTime?
  returnedById    String?
  returnedBy      User?          @relation("ReturnedBy", fields: [returnedById], references: [id])
  returnCondition ReturnCondition?
  returnNotes     String?
  prepStatus      PrepStatus?
  prepContainer        String?
  isContainerLineItem  Boolean        @default(false)
  returnStatus    ReturnStatus?
  isSubhire         Boolean        @default(false)
  showSubhireOnDocs Boolean        @default(false)
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  subhireOrderNumber String?
  supplierOrderId   String?
  supplierOrder     SupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  subHireId         String?
  subHire           SubHire?       @relation(fields: [subHireId], references: [id], onDelete: SetNull)
  subHireItemId     String?
  subHireItem       SubHireItem?   @relation(fields: [subHireItemId], references: [id], onDelete: SetNull)
  subHireGroupId    String?
  subHireGroup      SubHireGroup?  @relation(fields: [subHireGroupId], references: [id], onDelete: SetNull)
  service           ProjectService?
  checkRecords      CheckRecord[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([modelId])
  @@index([assetId])
  @@index([bulkAssetId])
  @@index([kitId])
  @@index([parentLineItemId])
  @@index([supplierId])
  @@index([supplierOrderId])
  @@index([subHireId])
  @@index([subHireItemId])
  @@index([subHireGroupId])
  @@index([categoryId])
  @@index([groupId])
  @@map("project_line_item")
}

// ─── Project Category ───────────────────────────────────────────────────────

model ProjectCategory {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  groups          ProjectGroup[]
  lineItems       ProjectLineItem[]
  // Sub-hire placement targets
  subHireDefaults      SubHire[]
  subHireGroupTargets  SubHireGroup[]
  subHireItemTargets   SubHireItem[]

  @@index([projectId])
  @@index([organizationId])
  @@map("project_category")
}

// ─── Project Group ──────────────────────────────────────────────────────────

model ProjectGroup {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  quantity        Int           @default(1)
  price           Decimal?      @db.Decimal(12, 2)
  suggestedPrice  Decimal?      @db.Decimal(12, 2)
  rentalPeriod    RentalPeriod?
  rentalQuantity  Int?
  billingMonths   Int?
  billingWeeks    Int?
  billingDays     Int?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems       ProjectLineItem[]
  // Sub-hire placement targets
  subHireDefaults      SubHire[]           @relation("SubHireDefaultTargetGroup")
  subHireGroupTargets  SubHireGroup[]      @relation("SubHireGroupTargetGroup")
  subHireItemTargets   SubHireItem[]       @relation("SubHireItemTargetGroup")

  @@index([projectId])
  @@index([categoryId])
  @@index([organizationId])
  @@map("project_group")
}

// ─── Project Manager (join table) ───────────────────────────────────────────

model ProjectManager {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("ProjectManagerAssignment", fields: [userId], references: [id], onDelete: Cascade)
  addedAt         DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_manager")
}

// ─── Group Template ─────────────────────────────────────────────────────────

model GroupTemplate {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           GroupTemplateItem[]

  @@index([organizationId])
  @@map("group_template")
}

// ─── Group Template Item ────────────────────────────────────────────────────

// Each template item references EITHER a model (soft line — pick any SM57 at
// checkout) OR a rigid Kit (hard reference to a pre-built rack/case). Exactly
// one of modelId / kitId is set. Kit items expand via addKitLineItem when the
// template is applied, pulling in the kit's children as usual.
model GroupTemplateItem {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId      String
  template        GroupTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  modelId         String?
  model           Model?   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  kitId           String?
  kit             Kit?     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  sortOrder       Int      @default(0)

  @@index([templateId])
  @@index([modelId])
  @@index([kitId])
  @@index([organizationId])
  @@map("group_template_item")
}

// ─── Asset Scan Log ──────────────────────────────────────────────────────────

model AssetScanLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId        String?
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  bulkAssetId    String?
  bulkAsset      BulkAsset?   @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)
  kitId          String?
  kit            Kit?         @relation(fields: [kitId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  action         ScanAction
  scannedById    String
  scannedBy      User         @relation(fields: [scannedById], references: [id])
  scannedAt      DateTime     @default(now())
  notes          String?
  location       String?

  @@index([organizationId])
  @@index([assetId])
  @@index([bulkAssetId])
  @@index([projectId])
  @@index([scannedAt])
  @@map("asset_scan_log")
}

// ─── File Upload & Media ────────────────────────────────────────────────────

model FileUpload {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String
  url            String
  thumbnailUrl   String?
  width          Int?
  height         Int?
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  modelMedia     ModelMedia[]
  assetMedia     AssetMedia[]
  kitMedia       KitMedia[]
  projectMedia   ProjectMedia[]
  clientMedia    ClientMedia[]
  locationMedia  LocationMedia[]
  subHireMedia   SubHireMedia[]

  @@index([organizationId])
  @@map("file_upload")
}

model ModelMedia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId        String
  model          Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           MediaType    @default(PHOTO)
  isPrimary      Boolean      @default(false)
  displayName    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([modelId, fileId])
  @@index([organizationId])
  @@index([modelId])
  @@map("model_media")
}

model AssetMedia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           MediaType    @default(PHOTO)
  isPrimary      Boolean      @default(false)
  displayName    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([assetId, fileId])
  @@index([organizationId])
  @@index([assetId])
  @@map("asset_media")
}

model KitMedia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitId          String
  kit            Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           MediaType    @default(PHOTO)
  isPrimary      Boolean      @default(false)
  displayName    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([kitId, fileId])
  @@index([organizationId])
  @@index([kitId])
  @@map("kit_media")
}

model ProjectMedia {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           ProjectMediaType @default(OTHER)
  displayName    String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())

  @@unique([projectId, fileId])
  @@index([organizationId])
  @@index([projectId])
  @@map("project_media")
}

model ClientMedia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           MediaType    @default(DOCUMENT)
  displayName    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([clientId, fileId])
  @@index([organizationId])
  @@index([clientId])
  @@map("client_media")
}

model LocationMedia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           MediaType    @default(DOCUMENT)
  displayName    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([locationId, fileId])
  @@index([organizationId])
  @@index([locationId])
  @@map("location_media")
}

model SubHireMedia {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subHireId      String
  subHire        SubHire      @relation(fields: [subHireId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileUpload   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  type           MediaType    @default(DOCUMENT)
  displayName    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([subHireId, fileId])
  @@index([organizationId])
  @@index([subHireId])
  @@map("sub_hire_media")
}

// ─── Test Profile ─────────────────────────────────────────────────────────

model TestProfile {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  equipmentClass       EquipmentClass @default(CLASS_I)
  applianceType        ApplianceType  @default(APPLIANCE)
  visualChecks         Json           // Array of {key, label, enabled}
  electricalTests      Json           // Array of {key, label, threshold, operator, unit, enabled}
  thresholds           Json           // {earthMax, insulationMin, leakageMax, rcdTripTimeMax, ...}
  requiresSubTests     Boolean        @default(false)
  defaultSubTestCount  Int            @default(1)
  subTestLabel         String         @default("Outlet") // "Outlet" | "Phase" | custom
  isDefault            Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  testTagAssets        TestTagAsset[]
  testTagRecords       TestTagRecord[]
  models               Model[]        @relation("ModelDefaultTestProfile")

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, equipmentClass, applianceType])
  @@map("test_profile")
}

// ─── Test & Tag Asset ───────────────────────────────────────────────────────

model TestTagAsset {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testTagId          String
  description        String
  equipmentClass     EquipmentClass @default(CLASS_I)
  applianceType      ApplianceType  @default(APPLIANCE)
  make               String?
  modelName          String?
  serialNumber       String?
  location           String?
  testIntervalMonths Int            @default(3)
  status             TestTagStatus  @default(NOT_YET_TESTED)
  lastTestDate       DateTime?
  nextDueDate        DateTime?
  notes              String?

  assetId            String?        @unique
  asset              Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  bulkAssetId        String?
  bulkAsset          BulkAsset?     @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)

  testProfileId      String?
  testProfile        TestProfile?   @relation(fields: [testProfileId], references: [id], onDelete: SetNull)
  outletCount        Int?

  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  testRecords        TestTagRecord[]

  @@unique([organizationId, testTagId])
  @@index([organizationId, status])
  @@index([organizationId, nextDueDate])
  @@index([organizationId, assetId])
  @@index([organizationId, bulkAssetId])
  @@index([testProfileId])
  @@map("test_tag_asset")
}

// ─── Test & Tag Record ──────────────────────────────────────────────────────

model TestTagRecord {
  id                     String         @id @default(cuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testTagAssetId         String
  testTagAsset           TestTagAsset   @relation(fields: [testTagAssetId], references: [id], onDelete: Cascade)
  testProfileId          String?
  testProfile            TestProfile?   @relation(fields: [testProfileId], references: [id], onDelete: SetNull)
  testDate               DateTime
  testedById             String
  testedBy               User           @relation(fields: [testedById], references: [id])
  testerName             String

  result                 TestResult     @default(PASS)

  // Visual inspection
  visualInspectionResult TestResult     @default(PASS)
  visualCordCondition    Boolean?
  visualPlugCondition    Boolean?
  visualHousingCondition Boolean?
  visualSwitchCondition  Boolean?
  visualVentsUnobstructed Boolean?
  visualCordGrip         Boolean?
  visualEarthPin         Boolean?
  visualMarkingsLegible  Boolean?
  visualNoModifications  Boolean?
  visualNotes            String?

  // Electrical tests
  equipmentClassTested   EquipmentClass @default(CLASS_I)
  testMethod             TestMethod     @default(INSULATION_RESISTANCE)

  // Earth continuity (Class I only)
  earthContinuityResult  TestResult     @default(NOT_APPLICABLE)
  earthContinuityReading Float?

  // Insulation resistance
  insulationResult       TestResult     @default(NOT_APPLICABLE)
  insulationReading      Float?
  insulationTestVoltage  Int?

  // Leakage current
  leakageCurrentResult   TestResult     @default(NOT_APPLICABLE)
  leakageCurrentReading  Float?

  // Polarity
  polarityResult         TestResult     @default(NOT_APPLICABLE)

  // RCD trip time
  rcdTripTimeResult      TestResult     @default(NOT_APPLICABLE)
  rcdTripTimeReading     Float?

  // Functional test
  functionalTestResult   TestResult     @default(NOT_APPLICABLE)
  functionalTestNotes    String?

  // Failure actions
  failureAction          FailureAction  @default(NONE)
  failureNotes           String?

  // Next test
  nextDueDate            DateTime

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  subTestRecords         SubTestRecord[]

  @@index([organizationId, testTagAssetId])
  @@index([organizationId, testDate])
  @@index([testProfileId])
  @@map("test_tag_record")
}

// ─── Sub-Test Record ──────────────────────────────────────────────────────

model SubTestRecord {
  id                     String         @id @default(cuid())
  testTagRecordId        String
  testTagRecord          TestTagRecord  @relation(fields: [testTagRecordId], references: [id], onDelete: Cascade)
  label                  String         // "Outlet 1", "Phase L1-L2", etc.
  sortOrder              Int            @default(0)
  result                 TestResult     @default(PASS)

  // Electrical readings (same columns as parent record)
  earthContinuityResult  TestResult     @default(NOT_APPLICABLE)
  earthContinuityReading Float?
  insulationResult       TestResult     @default(NOT_APPLICABLE)
  insulationReading      Float?
  leakageCurrentResult   TestResult     @default(NOT_APPLICABLE)
  leakageCurrentReading  Float?
  polarityResult         TestResult     @default(NOT_APPLICABLE)
  notes                  String?

  createdAt              DateTime       @default(now())

  @@index([testTagRecordId, sortOrder])
  @@map("sub_test_record")
}

// ─── Better Auth Two-Factor Tables ──────────────────────────────────────────

model TwoFactor {
  id            String   @id @default(cuid())
  secret        String
  backupCodes   String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model BackupCode {
  id        String   @id @default(cuid())
  code      String
  used      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("backup_code")
}

model Passkey {
  id              String   @id @default(cuid())
  name            String?
  publicKey       String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID    String   @unique
  counter         Int
  deviceType      String
  backedUp        Boolean
  transports      String?
  aaguid          String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("passkey")
}

// ─── Site Settings ──────────────────────────────────────────────────────────

model SiteSettings {
  id                     String   @id @default(cuid())
  platformName           String   @default("GearFlow")
  platformIcon           String?  // Lucide icon name, e.g. "clapperboard", "zap"
  platformLogo           String?
  registrationPolicy     String   @default("OPEN") // OPEN, INVITE_ONLY, DISABLED
  twoFactorGlobalPolicy  String   @default("OFF")  // OFF, RECOMMENDED, REQUIRED_SITE_ADMINS, REQUIRED_ALL
  defaultCurrency        String   @default("AUD")
  defaultTaxRate         Float    @default(10)
  allowOrgCreation       Boolean  @default(true)
  socialLoginGoogle      Boolean  @default(false)
  socialLoginMicrosoft   Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("site_settings")
}

// ─── Activity Log ────────────────────────────────────────────────────────────

model ActivityLog {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  action          String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, CHECK_OUT, CHECK_IN, etc.
  entityType      String   // asset, bulkAsset, model, kit, project, client, location, etc.
  entityId        String
  entityName      String   // Human-readable name/tag at time of action

  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName        String   // Denormalized — preserved if user is deleted

  summary         String   // Human-readable: "Created asset GF-00042"
  details         Json?    // Structured change data
  metadata        Json?    // Extra context

  projectId       String?
  assetId         String?
  kitId           String?

  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType])
  @@index([organizationId, userId])
  @@index([organizationId, projectId])
  @@index([organizationId, assetId])
  @@index([organizationId, entityType, entityId])
  @@map("activity_log")
}

// ─── Crew Management ─────────────────────────────────────────────────────────

model CrewMember {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identity
  firstName       String
  lastName        String
  email           String?
  phone           String?
  image           String?

  // Link to platform user (optional)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Employment type
  type            CrewMemberType  @default(FREELANCER)
  status          CrewMemberStatus @default(ACTIVE)
  department      String?

  // Rates
  defaultDayRate    Decimal?  @db.Decimal(10, 2)
  defaultHourlyRate Decimal?  @db.Decimal(10, 2)
  overtimeMultiplier Decimal? @db.Decimal(3, 2)
  currency          String?

  // Contact & personal
  address           String?
  addressLatitude   Float?
  addressLongitude  Float?
  emergencyContactName  String?
  emergencyContactPhone String?
  dateOfBirth     DateTime?
  abnOrGst        String?

  // Notes & tags
  notes           String?
  tags            String[] @default([])

  // Calendar integration
  icalEnabled     Boolean  @default(false)
  icalToken       String?  @unique

  // Relations
  skills          CrewSkill[]
  certifications  CrewCertification[]
  assignments     CrewAssignment[]
  availability    CrewAvailability[]
  timeEntries     CrewTimeEntry[]
  crewRoleId      String?
  crewRole        CrewRole? @relation(fields: [crewRoleId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("crew_member")
}

enum CrewMemberType {
  EMPLOYEE
  FREELANCER
  CONTRACTOR
  VOLUNTEER
}

enum CrewMemberStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  ARCHIVED
}

model CrewRole {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  department      String?
  color           String?
  defaultRate     Decimal? @db.Decimal(10, 2)
  rateType        CrewRateType?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)

  crewMembers     CrewMember[]
  assignments     CrewAssignment[]
  projectServices ProjectService[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("crew_role")
}

enum CrewRateType {
  HOURLY
  DAILY
  FLAT
}

model CrewSkill {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  category        String?

  crewMembers     CrewMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("crew_skill")
}

model CrewCertification {
  id              String   @id @default(cuid())
  crewMemberId    String
  crewMember      CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  name            String
  issuedBy        String?
  certificateNumber String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  status          CrewCertStatus @default(NOT_VERIFIED)

  @@index([crewMemberId])
  @@map("crew_certification")
}

enum CrewCertStatus {
  CURRENT
  EXPIRING_SOON
  EXPIRED
  NOT_VERIFIED
}

model CrewAssignment {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  crewMemberId    String
  crewMember      CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  crewRoleId      String?
  crewRole        CrewRole? @relation(fields: [crewRoleId], references: [id], onDelete: SetNull)

  status          AssignmentStatus @default(PENDING)
  phase           ProjectPhase?
  isProjectManager Boolean @default(false)

  // Schedule
  startDate       DateTime?
  startTime       String?
  endDate         DateTime?
  endTime         String?

  // Rate
  rateOverride    Decimal?  @db.Decimal(10, 2)
  rateType        CrewRateType?
  estimatedHours  Decimal?  @db.Decimal(6, 2)
  estimatedCost   Decimal?  @db.Decimal(10, 2)

  // Notes
  notes           String?
  internalNotes   String?

  // Response tracking
  responseToken   String?  @unique
  offeredAt       DateTime?
  respondedAt     DateTime?
  responseNote    String?

  // Confirmation
  confirmedAt     DateTime?
  confirmedById   String?
  confirmedBy     User?    @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Service link (when assigned via a ProjectService)
  serviceId       String?
  service         ProjectService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  shifts          CrewShift[]
  timeEntries     CrewTimeEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Partial unique index created via raw SQL migration:
  // UNIQUE(projectId, crewMemberId, serviceId) WHERE serviceId IS NOT NULL
  @@index([organizationId])
  @@index([projectId])
  @@index([crewMemberId])
  @@index([crewMemberId, startDate])
  @@index([serviceId])
  @@map("crew_assignment")
}

enum AssignmentStatus {
  PENDING
  OFFERED
  ACCEPTED
  DECLINED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ProjectPhase {
  BUMP_IN
  EVENT
  BUMP_OUT
  DELIVERY
  PICKUP
  SETUP
  REHEARSAL
  FULL_DURATION
}

model CrewShift {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      CrewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  date            DateTime
  callTime        String?
  endTime         String?
  breakMinutes    Int?
  location        String?
  notes           String?
  status          ShiftStatus @default(SCHEDULED)

  @@index([assignmentId])
  @@index([assignmentId, date])
  @@map("crew_shift")
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── Crew Availability ──────────────────────────────────────────────────────

model CrewAvailability {
  id              String   @id @default(cuid())
  crewMemberId    String
  crewMember      CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  startDate       DateTime
  endDate         DateTime
  type            AvailabilityType @default(UNAVAILABLE)
  reason          String?
  isAllDay        Boolean  @default(true)
  startTime       String?
  endTime         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([crewMemberId])
  @@index([crewMemberId, startDate, endDate])
  @@map("crew_availability")
}

enum AvailabilityType {
  UNAVAILABLE
  TENTATIVE
  PREFERRED
}

// ── Time Tracking ──────────────────────────────────────────────────

model CrewTimeEntry {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignmentId    String?
  assignment      CrewAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  crewMemberId    String
  crewMember      CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  description     String?          // For standalone shifts not linked to a project

  date            DateTime
  startTime       String
  endTime         String
  breakMinutes    Int      @default(0)
  totalHours      Decimal? @db.Decimal(6, 2)

  status          TimeEntryStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?    @relation("TimeEntryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([assignmentId])
  @@index([crewMemberId, date])
  @@map("crew_time_entry")
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISPUTED
  EXPORTED
}

// ─── Project Services ───────────────────────────────────────────────────────

model ProjectService {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Type & description
  type            ServiceType
  title           String
  description     String?
  notes           String?

  // Schedule
  date            DateTime?
  endDate         DateTime?
  startTime       String?
  endTime         String?
  scheduledTime   String?   // Delivery/pickup time (separate from service work window)
  estimatedDuration Int?

  // Address (for delivery/pickup)
  address         String?
  latitude        Float?
  longitude       Float?

  // Status
  status          ServiceStatus @default(PLANNED)

  // Financial
  showOnDocuments Boolean  @default(false)
  billableToClient Boolean @default(false)
  unitPrice       Decimal? @db.Decimal(10, 2)
  quantity        Int      @default(1)
  pricingType     PricingType?
  duration        Decimal? @db.Decimal(6, 2)
  discount        Decimal? @db.Decimal(5, 2)
  lineTotal       Decimal? @db.Decimal(10, 2)
  costTotal       Decimal? @db.Decimal(12, 2)
  taxable         Boolean  @default(true)

  // Linked line item (legacy — being phased out, kept for migration)
  lineItemId      String?  @unique
  lineItem        ProjectLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  // Transport-specific (for DELIVERY/PICKUP)
  vehicleDescription String?
  numberOfTrips      Int?

  // Labour-specific
  crewCountRequired  Int?
  crewRoleId         String?
  crewRole           CrewRole? @relation(fields: [crewRoleId], references: [id], onDelete: SetNull)

  // Crew assignments linked to this service
  crewAssignments    CrewAssignment[]

  // Ordering
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, date])
  @@map("project_service")
}

enum ServiceType {
  DELIVERY
  PICKUP
  BUMP_IN
  BUMP_OUT
  LABOUR
  MISC
}

enum ServiceStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Service Templates ──────────────────────────────────────────────────────

model ServiceTemplate {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type            ServiceType
  title           String
  description     String?
  defaultCrewCount Int?
  defaultVehicle  String?
  defaultPricingType PricingType?
  defaultUnitPrice Decimal? @db.Decimal(10, 2)
  showOnDocuments Boolean  @default(false)
  isAutoAdded     Boolean  @default(false)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@map("service_template")
}

// ─── Brand Templates ─────────────────────────────────────────────────────────

model BrandTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  headerSettings String   @db.Text  // JSON — logo mode, org details visibility
  footerSettings String   @db.Text  // JSON — footer text, visibility
  accentColor    String?  // hex color override (null = use org's documentColor)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documentTemplates DocumentTemplate[]

  @@index([organizationId])
  @@map("brand_template")
}

// ─── Document Templates ──────────────────────────────────────────────────────

model DocumentTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  type           String   // "quote" | "invoice" | "packing-list" | "return-sheet" | "delivery-docket" | "call-sheet"

  // Legacy fields (preserved for backward compatibility)
  basePdf        String?  @db.Text  // JSON — page size, orientation, margins (legacy only)
  schemas        String?  @db.Text  // JSON — pdfme schema array (legacy only)
  settings       String?  @db.Text  // JSON — TemplateSettings (legacy settings-based config)

  // New section-based fields
  sections       String?  @db.Text  // JSON — TemplateSection[] (ordered section list)
  brandTemplateId String?
  brandTemplate  BrandTemplate? @relation(fields: [brandTemplateId], references: [id], onDelete: SetNull)
  thumbnailData  String?  @db.Text  // base64 thumbnail image

  isDefault      Boolean  @default(false)
  isDraft        Boolean  @default(true)
  version        Int      @default(1)
  thumbnailUrl   String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, type])
  @@map("document_template")
}

// ─── Section Presets (reusable custom sections across templates) ──────────────

model SectionPreset {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String   // e.g. "Bank Details", "Terms & Conditions"
  description    String?  // optional description
  sections       String   @db.Text  // JSON — TemplateSection[] (one or more sections)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("section_preset")
}

// ─── Warehouse Dashboard Display ─────────────────────────────────────────────

model WarehouseDashboardToken {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String               // "Main Warehouse TV", "Loading Dock Screen"
  token           String               // Raw access token (for URL display in settings)
  tokenHash       String   @unique     // SHA-256 of the access token (for lookup)
  locationId      String?              // Scope to a specific warehouse location
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive        Boolean  @default(true)
  layout          String   @default("standard") // "standard", "compact", "dispatch-only"

  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastAccessedAt  DateTime?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@map("warehouse_dashboard_token")
}

// ─── Test & Tag Auditor Portal ───────────────────────────────────────────────

model TestTagAuditorToken {
  id              String    @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String               // "Insurance Auditor", "Annual Compliance Check"
  token           String               // Raw access token (displayed in settings)
  tokenHash       String    @unique    // SHA-256 for secure lookup
  isActive        Boolean   @default(true)
  expiresAt       DateTime?            // Optional expiry date
  scope           String?              // JSON: { categories?, equipmentClasses?, locations?, assetIds? }

  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastAccessedAt  DateTime?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@map("test_tag_auditor_token")
}

// ─── WooCommerce Integration ─────────────────────────────────────────────────

model WooCommerceIntegration {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isEnabled       Boolean  @default(false)
  webhookSecret   String                     // Shared secret for HMAC verification
  storeUrl        String?                    // WooCommerce store URL (for reference/display)

  // Matching strategy
  productMatchField String  @default("sku")  // "sku", "custom_field", "name"
  customFieldKey    String?                   // If productMatchField = "custom_field", which meta key

  // Date field mapping (WooCommerce meta_data keys → project fields)
  rentalStartKey    String?                   // e.g. "rental_start_date"
  rentalEndKey      String?                   // e.g. "rental_end_date"
  eventStartKey     String?                   // e.g. "event_date"
  deliveryAddressKey String?                  // e.g. "delivery_address"
  notesKey          String?                   // e.g. "order_notes" or "customer_note"

  // Date format preference
  dateFormat        String  @default("auto")  // "auto", "DD/MM/YYYY", "MM/DD/YYYY", "ISO"

  // Location mapping
  locationMetaKey    String?                  // WooCommerce meta key containing venue/location name
  defaultLocationId  String?                  // Fallback location if no meta key match

  // Defaults for created projects
  defaultProjectType String @default("DRY_HIRE")
  autoConfirmEnquiry Boolean @default(false)  // If true, set status to QUOTING instead of ENQUIRY

  // Notification
  notifyUserIds     String[] @default([])     // User IDs to notify on new website orders

  // Last webhook payload (for "Test & Detect" feature)
  lastPayload       Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("woocommerce_integration")
}

model WooCommerceOrderLog {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  wooOrderId      Int                        // WooCommerce order ID
  wooOrderNumber  String?                    // WooCommerce order number (may differ from ID)
  status          WooOrderLogStatus          // RECEIVED, PROCESSING, COMPLETED, FAILED, DUPLICATE

  // What was created
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId        String?

  // Debugging
  payload         Json                       // Full webhook payload (for debugging)
  errorMessage    String?                    // If FAILED
  matchResults    Json?                      // Which products matched which models
  dateExtraction  Json?                      // Date parsing results for display

  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([wooOrderId])
  @@map("woocommerce_order_log")
}

enum WooOrderLogStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
}

// ─── Saved Reports ──────────────────────────────────────────────────────────

model SavedReport {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  dataSource      String           // "assets", "models", "projects", "kits", "lineItems", "clients", "locations", "maintenance", "activityLog", "crew", "crewAssignments"
  config          Json             // Full ReportConfig JSON
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  isShared        Boolean  @default(false)
  isPinned        Boolean  @default(false)

  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, createdById])
  @@map("saved_report")
}

// ─── Check Item System ───────────────────────────────────────────────────────

model CheckItem {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label            String
  description      String?
  type             CheckItemType @default(PASS_FAIL)
  category         String?
  measurementUnit  String?       // for MEASUREMENT type (e.g. "mm", "kg", "V")
  measurementMin   Float?        // pass threshold minimum
  measurementMax   Float?        // pass threshold maximum
  dropdownOptions  Json?         // for DROPDOWN type: { label: string, isFail: boolean }[]
  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  modelCheckItems  ModelCheckItem[]
  kitCheckItems    KitCheckItem[]
  checkRecords     CheckRecord[]

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("check_item")
}

model ModelCheckItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelId        String
  model          Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  checkItemId    String
  checkItem      CheckItem    @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([modelId, checkItemId])
  @@index([organizationId])
  @@index([organizationId, modelId])
  @@map("model_check_item")
}

model KitCheckItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kitId          String
  kit            Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  checkItemId    String
  checkItem      CheckItem    @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([kitId, checkItemId])
  @@index([organizationId])
  @@index([organizationId, kitId])
  @@map("kit_check_item")
}

model CheckRecord {
  id                      String        @id @default(cuid())
  organizationId          String
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  context                 CheckContext
  lineItemId              String?       // null for AD_HOC
  lineItem                ProjectLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  assetId                 String?       // null when no serialized asset assigned
  asset                   Asset?        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  bulkAssetId             String?       // for bulk asset checks
  bulkAsset               BulkAsset?    @relation(fields: [bulkAssetId], references: [id], onDelete: SetNull)
  kitId                   String?       // for kit-level checks
  kit                     Kit?          @relation(fields: [kitId], references: [id], onDelete: SetNull)
  checkItemId             String
  checkItem               CheckItem     @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  checkItemLabelSnapshot  String
  checkItemTypeSnapshot   CheckItemType
  result                  CheckResult
  value                   String?       // measurement reading or dropdown selection
  notes                   String?
  photos                  String[]      @default([]) // S3 keys
  performedById           String
  performedBy             User          @relation("CheckRecordPerformedBy", fields: [performedById], references: [id], onDelete: Cascade)
  performedAt             DateTime      @default(now())

  @@index([organizationId])
  @@index([organizationId, assetId])
  @@index([organizationId, checkItemId])
  @@index([lineItemId])
  @@map("check_record")
}

model WarehouseClose {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedById     String
  closedBy       User         @relation("WarehouseClosedBy", fields: [closedById], references: [id], onDelete: Cascade)
  closedAt       DateTime     @default(now())
  storedCount    Int          @default(0)
  damagedCount   Int          @default(0)
  lostCount      Int          @default(0)

  @@unique([projectId, organizationId])
  @@index([organizationId])
  @@map("warehouse_close")
}

