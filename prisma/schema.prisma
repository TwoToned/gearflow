  // Identity
  firstName String
  lastName  String
  email     String?
  phone     String?
  image     String?

  // Link to platform user (optional)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Employment type
  type       CrewMemberType   @default(FREELANCER)
  status     CrewMemberStatus @default(ACTIVE)
  department String?

  // Rates
  defaultDayRate     Decimal? @db.Decimal(10, 2)
  defaultHourlyRate  Decimal? @db.Decimal(10, 2)
  overtimeMultiplier Decimal? @db.Decimal(3, 2)
  currency           String?

  // Contact & personal
  address               String?
  addressLatitude       Float?
  addressLongitude      Float?
  emergencyContactName  String?
  emergencyContactPhone String?
  dateOfBirth           DateTime?
  abnOrGst              String?

  // Notes & tags
  notes String?
  tags  String[] @default([])

  // Calendar integration
  icalEnabled Boolean @default(false)
  icalToken   String? @unique

  // Relations
  skills         CrewSkill[]
  assignments    CrewAssignment[]
  availability   CrewAvailability[]
  timeEntries    CrewTimeEntry[]
  crewRoleId     String?
  crewRole       CrewRole?           @relation(fields: [crewRoleId], references: [id], onDelete: SetNull)

