generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth Core Tables ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "user" or "admin" (site-level)
  banned        Boolean?
  banReason     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth 2FA fields
  twoFactorEnabled Boolean?

  sessions Session[]
  accounts Account[]
  members  Member[]

  // App relations
  reportedMaintenance MaintenanceRecord[] @relation("ReportedBy")
  assignedMaintenance MaintenanceRecord[] @relation("AssignedTo")
  managedProjects     Project[]           @relation("ProjectManager")
  scanLogs            AssetScanLog[]
  checkedOutLineItems ProjectLineItem[]   @relation("CheckedOutBy")
  returnedLineItems   ProjectLineItem[]   @relation("ReturnedBy")
  addedKitSerializedItems KitSerializedItem[] @relation("KitSerializedItemAddedBy")
  addedKitBulkItems       KitBulkItem[]      @relation("KitBulkItemAddedBy")
  uploads                 FileUpload[]
  testTagRecords          TestTagRecord[]
  twoFactors              TwoFactor[]
  backupCodes             BackupCode[]
  activityLogs            ActivityLog[]
  passkeys                Passkey[]
  supplierOrders          SupplierOrder[]
  crewMembers             CrewMember[]
  confirmedAssignments    CrewAssignment[] @relation("ConfirmedBy")
  approvedTimeEntries     CrewTimeEntry[]  @relation("TimeEntryApprovedBy")
  ssoProviders            SsoProvider[]
  pendingSSOApprovals     PendingSSOApproval[]
  reviewedSSOApprovals    PendingSSOApproval[] @relation("SSOReviewer")
  warehouseDashboardTokens WarehouseDashboardToken[]
  testTagAuditorTokens     TestTagAuditorToken[]
  savedReports             SavedReport[]
  checkItems               CheckItem[]
  checkRecords             CheckRecord[]  @relation("CheckRecordPerformedBy")
  warehouseCloses          WarehouseClose[] @relation("WarehouseClosedBy")
  projectManagerAssignments ProjectManager[] @relation("ProjectManagerAssignment")
  subHires                   SubHire[]

  @@map("user")
}

model Session {
  id                   String    @id @default(cuid())
  expiresAt            DateTime
  token                String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Better Auth Organization Tables ─────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  metadata       String?   // JSON string for extended org settings
  defaultTaxRate Decimal?  @db.Decimal(5, 2)

  members     Member[]
  invitations Invitation[]
  customRoles CustomRole[]

  // App relations
  categories         Category[]
  models             Model[]
  assets             Asset[]
  bulkAssets         BulkAsset[]
  locations          Location[]
  maintenanceRecords MaintenanceRecord[]
  clients            Client[]
  projects           Project[]
  projectLineItems   ProjectLineItem[]
  scanLogs           AssetScanLog[]
  suppliers          Supplier[]
  supplierOrders     SupplierOrder[]
  kits               Kit[]
  kitSerializedItems KitSerializedItem[]
  kitBulkItems       KitBulkItem[]
  fileUploads        FileUpload[]
  modelMedia         ModelMedia[]
  assetMedia         AssetMedia[]
  kitMedia           KitMedia[]
  projectMedia       ProjectMedia[]
  clientMedia        ClientMedia[]
  locationMedia      LocationMedia[]
  subHireMedia       SubHireMedia[]
  testProfiles       TestProfile[]
  testTagAssets      TestTagAsset[]
  testTagRecords     TestTagRecord[]
  activityLogs       ActivityLog[]
  crewMembers        CrewMember[]
  crewRoles          CrewRole[]
  crewSkills         CrewSkill[]
  crewAssignments    CrewAssignment[]
  crewTimeEntries    CrewTimeEntry[]
  projectServices    ProjectService[]
  serviceTemplates   ServiceTemplate[]
  documentTemplates          DocumentTemplate[]
  brandTemplates             BrandTemplate[]
  sectionPresets             SectionPreset[]
  ssoProviders               SsoProvider[]
  pendingSSOApprovals        PendingSSOApproval[]
  warehouseDashboardTokens   WarehouseDashboardToken[]
  testTagAuditorTokens       TestTagAuditorToken[]
  wooCommerceIntegration     WooCommerceIntegration?
  wooCommerceOrderLogs       WooCommerceOrderLog[]
  savedReports               SavedReport[]
  checkItems                 CheckItem[]
  modelCheckItems            ModelCheckItem[]
  kitCheckItems              KitCheckItem[]
  checkRecords               CheckRecord[]
  warehouseCloses            WarehouseClose[]
  projectCategories          ProjectCategory[]
  projectGroups              ProjectGroup[]
  groupTemplates             GroupTemplate[]
  groupTemplateItems         GroupTemplateItem[]
  projectManagers            ProjectManager[]
  subHires                   SubHire[]
  supplierModelRates         SupplierModelRate[]
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       // owner, admin, manager, staff, warehouse
  createdAt      DateTime     @default(now())

  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       // pending, accepted, rejected, cancelled
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())

  @@map("invitation")
}

// ─── Custom Roles ──────────────────────────────────────────────────────────

model CustomRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  color          String?      // Badge color class
  permissions    String       // JSON-serialized PermissionMap
  ssoGroupClaim  String?      // OIDC/SAML group claim value for auto-matching
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("custom_role")
}

// ─── Better Auth SSO Tables ────────────────────────────────────────────────

/// Managed by @better-auth/sso plugin. Mapped here for type-safe Prisma queries.
model SsoProvider {
  id             String        @id @default(cuid())
  issuer         String
  oidcConfig     String?       // JSON-encoded OIDC settings
  samlConfig     String?       // JSON-encoded SAML settings
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerId     String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain         String
  domainVerified Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([domain])
  @@map("sso_provider")
}

// ─── SSO Approval Workflow ─────────────────────────────────────────────────

enum SSOApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingSSOApproval {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  idpGroups      String[]          @default([])
  suggestedRole  String?
  providerId     String
  status         SSOApprovalStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("SSOReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("pending_sso_approval")
}

// ─── App Data Models ─────────────────────────────────────────────────────────

enum AssetType {
  SERIALIZED
  BULK
}

enum AssetStatus {
  AVAILABLE
  CHECKED_OUT
  IN_MAINTENANCE
  RETIRED
  LOST
  RESERVED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum BulkAssetStatus {
  ACTIVE
  LOW_STOCK
  OUT_OF_STOCK
  RETIRED
}

enum LocationType {
  WAREHOUSE
  VENUE
  VEHICLE
  OFFSITE
}

enum MaintenanceType {
  REPAIR
  PREVENTATIVE
  TEST_AND_TAG
  INSPECTION
  CLEANING
  FIRMWARE_UPDATE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceResult {
  PASS
  FAIL
  CONDITIONAL
}

enum ClientType {
  COMPANY
  INDIVIDUAL
  VENUE
  PRODUCTION_COMPANY
}

enum ProjectStatus {
  ENQUIRY
  QUOTING
  QUOTED
  CONFIRMED
  PREPPING
  CHECKED_OUT
  ON_SITE
  RETURNED
  COMPLETED
  INVOICED
  CANCELLED
}

enum ProjectType {
  DRY_HIRE
  WET_HIRE
  INSTALLATION
  TOUR
  CORPORATE
  THEATRE
  FESTIVAL
  CONFERENCE
  OTHER
}

enum LineItemType {
  EQUIPMENT
  SERVICE
  LABOUR
  TRANSPORT
  MISC
}

enum PricingType {
  PER_DAY
  PER_WEEK
  FLAT
  PER_HOUR
  OPTIMIZED
}

enum RentalPeriod {
  DAILY
  WEEKLY
}

enum LineItemStatus {
  QUOTED
  CONFIRMED
  PREPPED
  CHECKED_OUT
  RETURNED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  MISSING
}

enum ScanAction {
  CHECK_OUT
  CHECK_IN
  SCAN_VERIFY
  TRANSFER
}

// ─── Check Item System Enums ─────────────────────────────────────────────────

enum CheckItemType {
  PASS_FAIL
  NOTES
  MEASUREMENT
  DROPDOWN
}

enum CheckContext {
  PREP
  RETURN
  AD_HOC
}

enum CheckResult {
  PASS
  FAIL
  NOTES_ONLY
}

