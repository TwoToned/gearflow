# GearFlow environment — copy to .env and fill in. Required vars are validated at
# boot by src/env.ts; a missing one fails loudly. See CLAUDE.md for the full list.

# ── Core (required) ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gearflow?schema=public"
BETTER_AUTH_SECRET="change-me-use-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── DB connection hardening (optional, safe defaults — see src/lib/db-url.ts) ──
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_POOL_TIMEOUT_S=10
# DB_CONNECTION_LIMIT=

# ── Email (Resend; logs to console if unset) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="GearFlow <noreply@gearflow.app>"

# ── File storage (S3 / MinIO) ─────────────────────────────────────────────────
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=gearflow-uploads
S3_ENDPOINT=http://localhost:9000
UPLOAD_MAX_SIZE_MB=50

# ── Auth / branding ───────────────────────────────────────────────────────────
PASSKEY_RP_ID=localhost
PLATFORM_NAME=GearFlow
# ADMIN_REGISTRATION_TOKEN / SITE_ADMIN_SECRET_TOKEN — admin registration token
SITE_ADMIN_SECRET_TOKEN=change-me-at-least-32-chars
SITE_ADMIN_REGISTRATION_ENABLED=true

# ── OAuth (optional; set id + secret together) ────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ── Google Maps ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Cron / error tracking (optional) ──────────────────────────────────────────
# CRON_SECRET=
# SENTRY_DSN=

# ── Convex (hybrid migration — docs/designs/convex-hybrid-migration.md) ────────
# Self-hosted backend; infra config lives in .env.convex.example. The admin key
# comes from `docker compose -f docker-compose.convex.yml exec backend ./generate_admin_key.sh`.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
