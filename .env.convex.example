# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted Convex backend config — template.
#
# Copy to .env.convex.local (gitignored) and fill in the secret values:
#   cp .env.convex.example .env.convex.local
#
# Consumed by docker-compose.convex.yml (env_file + ${VAR} substitution).
# See docs/designs/convex-hybrid-migration.md, Phase 0.
# ─────────────────────────────────────────────────────────────────────────────

# Instance identity ───────────────────────────────────────────────────────────
# The Postgres database name is derived from INSTANCE_NAME with '-' -> '_'.
# gearflow-convex => database "gearflow_convex" (create it before first boot).
CONVEX_INSTANCE_NAME=gearflow-convex

# 64-char hex secret that seeds this instance's keys. Generate once with:
#   openssl rand -hex 32
# Keep it stable — changing it invalidates previously generated admin keys.
INSTANCE_SECRET=replace-with-openssl-rand-hex-32

# Database ────────────────────────────────────────────────────────────────────
# Connection string WITHOUT the database name and WITHOUT query params.
# Convex appends the db named after INSTANCE_NAME. From inside the container the
# host's Postgres is reachable at host.docker.internal (mapped to host-gateway).
POSTGRES_URL=postgresql://postgres:postgres@host.docker.internal:5432

# Local Postgres has no TLS — required, or the backend refuses to connect.
# Remove (or set empty) when pointing at a managed Postgres that enforces SSL.
DO_NOT_REQUIRE_SSL=1

# Ports (host side) ────────────────────────────────────────────────────────────
CONVEX_PORT=3210
CONVEX_SITE_PROXY_PORT=3211
CONVEX_DASHBOARD_PORT=6791

# Public origins — only override for non-localhost deploys (e.g. behind DNS):
#   CONVEX_CLOUD_ORIGIN=https://convex-api.twotoned.com.au
#   CONVEX_SITE_ORIGIN=https://convex-api.twotoned.com.au:3211

# File storage (OPTIONAL) ──────────────────────────────────────────────────────
# Phase 0 uses the local Docker volume (convex_data) for storage — leave this
# block commented out. To move storage onto the existing MinIO/S3 instead,
# create the five buckets and uncomment. Reuses the gearflow-uploads MinIO box.
#
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT_URL=http://host.docker.internal:9000
# AWS_S3_FORCE_PATH_STYLE=true        # required for MinIO
# AWS_S3_DISABLE_SSE=true             # MinIO without server-side encryption
# S3_STORAGE_FILES_BUCKET=gearflow-convex-files
# S3_STORAGE_EXPORTS_BUCKET=gearflow-convex-exports
# S3_STORAGE_MODULES_BUCKET=gearflow-convex-modules
# S3_STORAGE_SEARCH_BUCKET=gearflow-convex-search
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=gearflow-convex-snapshots
