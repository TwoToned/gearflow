/// What kind of child a non-top-level ProjectLineItem is. Set alongside
/// `isKitChild: true` + `parentLineItemId`. KIT = a kit member; ACCESSORY = a
/// child asset / accessory permanently attached to a parent asset.
enum LineItemChildKind {
  KIT
  ACCESSORY
}

/// How a line item's `allocatedRevenue` was decided. Both an audit trail and a
/// correctness primitive: ROI aggregation counts a row ONLY when its basis is one
/// of the four "earned" values. See docs/revenue-allocation-design.md.
enum AllocationBasis {
  /// Leaf line priced on its own — allocatedRevenue == lineTotal.
  DIRECT
  /// Split by the parent kit's saved per-model allocationPercent.
  KIT_PERCENT
  /// Split proportionally by the weight chain (lineTotal -> rate -> replacementCost).
  WEIGHTED
  /// Nothing to weight on; the pool was split evenly.
  EQUAL_SPLIT
  /// Sub-hired gear. Consumes pool weight (so owned gear isn't over-credited) and
  /// the number is stored for audit — but it isn't our capital, so it never counts
  /// toward model ROI.
  EXCLUDED_SUBHIRE
  /// Custom / labour / container line. No modelId; nothing to attribute.
  EXCLUDED_NON_GEAR
  /// WS11 (#950) — a SALE line. Consumes no rental-ROI weight and never enters
  /// projectModelRevenues (sale revenue lives in its own P&L bucket).
  EXCLUDED_SALE
  /// Pool was $0 (unpriced group, $0 kit), or the line is cancelled / optional.
  NO_REVENUE
}

enum KitCheckMode {
  KIT_LEVEL // Check the kit once; all contents inherit the result
  PER_ITEM // Each child asset goes through its own model's checks
