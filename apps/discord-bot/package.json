{
  "name": "@gearflow/discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "GearFlow Discord bot — standalone discord.js v14 service. Holds no DB access; talks to GearFlow via signed /api/discord/v1/* endpoints.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "doctor": "tsx src/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
