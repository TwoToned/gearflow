  kitId          String?
  kit            Kit?          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  quantity       Int           @default(1)
  sortOrder      Int           @default(0)

  @@index([templateId])
  @@index([modelId])
  @@index([kitId])
  @@index([organizationId])
  @@map("group_template_item")
}

